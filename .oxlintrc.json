{
   "$schema": "./node_modules/oxlint/configuration_schema.json",
   "ignorePatterns": [
      ".aix/**",
      ".claude/**",
      "packages/cli/test/fixtures/apg/**",
      "packages/wcag-data/test/apg/**"
   ],
   "plugins": ["typescript", "unicorn", "oxc", "node"],
   "jsPlugins": ["oxlint-plugin-complexity"],
   "categories": {
      "correctness": "error",
      "pedantic": "error",
      "perf": "error",
      "restriction": "error",
      "style": "error",
      "suspicious": "error"
   },
   "rules": {
      "no-async-await": "off",
      "no-rest-spread-properties": "off",
      "no-optional-chaining": "off",
      "sort-keys": "off",
      "array-type": "off",
      "sort-imports": "off",
      "prefer-destructuring": "off",
      "no-continue": "off",
      "no-ternary": "off",
      "no-nested-ternary": "error",
      "max-lines": [
         "error",
         {
            "max": 350
         }
      ],
      "max-lines-per-function": [
         "error",
         {
            "max": 60
         }
      ],
      "max-statements": [
         "error",
         {
            "max": 15
         }
      ],
      "no-undefined": "off",
      "no-magic-numbers": [
         "error",
         {
            "ignore": [0, -1, 1, 10]
         }
      ],
      "func-style": "off",
      "require-await": "off",
      "complexity/complexity": "error"
   },
   "env": {
      "builtin": true
   }
}
