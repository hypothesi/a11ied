{
   "name": "a11ied",
   "version": "0.1.0",
   "private": true,
   "description": "CLI-first accessibility automation toolkit built on Guidepup.",
   "workspaces": [
      "apps/*",
      "packages/*"
   ],
   "type": "module",
   "scripts": {
      "build": "turbo run build",
      "clean": "rimraf .turbo .test-coverage dist apps/*/dist apps/*/.astro packages/*/dist",
      "dev:docs": "turbo run dev --filter=@a11ied/docs",
      "format": "oxlint --fix --ignore-pattern 'apps/docs/playwright-verify.ts' && oxfmt",
      "lint": "oxlint --ignore-pattern 'apps/docs/playwright-verify.ts' && oxfmt --check",
      "standards": "turbo run lint typecheck build && npm run test",
      "test": "rimraf .test-coverage && vitest run --coverage",
      "test:watch": "vitest",
      "typecheck": "turbo run typecheck",
      "wcag:sync": "npm run sync --workspace @a11ied/wcag-data",
      "wcag:validate": "npm run validate --workspace @a11ied/wcag-data"
   },
   "devDependencies": {
      "@types/jsdom": "^27.0.0",
      "@types/node": "^25.5.2",
      "@vitest/coverage-v8": "^4.1.2",
      "globals": "^17.4.0",
      "oxfmt": "0.44.0",
      "oxlint": "1.59.0",
      "oxlint-plugin-complexity": "2.1.1",
      "rimraf": "^6.1.3",
      "tsup": "^8.5.1",
      "tsx": "^4.21.0",
      "turbo": "^2.9.6",
      "typescript": "^6.0.2",
      "vitest": "^4.1.2"
   },
   "packageManager": "npm@11.8.0"
}
