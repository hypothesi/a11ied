{
   "$schema": "./node_modules/oxfmt/configuration_schema.json",
   "ignorePatterns": [
      "**/dist/**",
      "**/coverage/**",
      "packages/docs/.astro/**",
      ".aix/**",
      ".claude/**",
      "styles/**"
   ],
   "printWidth": 90,
   "tabWidth": 3,
   "singleQuote": true,
   "bracketSameLine": true,
   "jsdoc": true
}
