---
import DocShell from '../layouts/doc-shell.astro';
import { docsLinks } from '../lib/nav';
---

<DocShell
   title="API reference"
   summary="a11ied is organized as npm workspaces. Each package has a focused public API. Import from package entrypoints — internal file paths are not part of the supported surface."
   links={docsLinks}
>
   <section>
      <h2>Packages</h2>
      <ul>
         <li><code>@a11ied/contracts</code>: shared runtime schemas and result shapes</li>
         <li><code>@a11ied/core</code>: WCAG lookup, target resolution, driver orchestration, pattern execution, and verification</li>
         <li><code>@a11ied/guidepup</code>: platform adapters for VoiceOver, NVDA, and the virtual reader</li>
         <li><code>@a11ied/storybook</code>: Storybook recipe helpers</li>
         <li><code>@a11ied/wcag-data</code>: standards-data sync and normalization</li>
         <li><code>@a11ied/wcag-engine</code>: lookup, search, coverage, and applicability over generated artifacts</li>
         <li><code>@a11ied/mcp-server</code>: MCP server entrypoint</li>
         <li><code>a11ied</code>: CLI entrypoint and command builder</li>
      </ul>
   </section>

   <section>
      <h2>Package responsibilities</h2>
      <div class="route-list">
         <div class="route-row"><code>@a11ied/contracts</code><span>Shared schemas, result types, and command metadata.</span></div>
         <div class="route-row"><code>@a11ied/wcag-data</code> and <code>@a11ied/wcag-engine</code><span>Standards data: synced artifacts, search, lookup, coverage, and applicability rules.</span></div>
         <div class="route-row"><code>@a11ied/guidepup</code> and <code>@a11ied/core</code><span>Execution engine: targets, sessions, patterns, axe runs, verification, and recording.</span></div>
         <div class="route-row"><code>@a11ied/mcp-server</code> and <code>a11ied</code><span>User-facing surfaces: MCP tools over stdio and CLI commands in the terminal.</span></div>
      </div>
   </section>

   <section>
      <h2>About this reference</h2>
      <p>
         This page maps which package owns which functionality. For detailed API documentation,
         see the JSDoc comments on each package's public exports.
      </p>
   </section>

   <section class="field-note">
      <h2>Import from entrypoints</h2>
      <p>
         Each package's main export is the supported API surface. Importing from internal file
         paths may break between releases.
      </p>
   </section>
</DocShell>
