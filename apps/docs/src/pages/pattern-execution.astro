---
import DocShell from '../layouts/doc-shell.astro';
import { docsLinks } from '../lib/nav';
---

<DocShell
   title="Pattern execution"
   summary="Patterns are reusable interaction probes — heading walks, landmark scans, dialog checks, and more. They produce consistent, repeatable evidence that the verification layer can use."
   links={docsLinks}
>
   <section>
      <h2>Built-in patterns</h2>
      <div class="mini-grid">
         <div class="stack"><code>tab_sequence</code><code>landmark_sequence</code><code>heading_sequence</code></div>
         <div class="stack"><code>form_field_walk</code><code>status_message_probe</code><code>dialog_probe</code></div>
         <div class="stack"><code>focus_order_probe</code><code>focus_visibility_probe</code><code>focus_obscured_probe</code></div>
         <div class="stack"><code>auth_flow_probe</code><code>redundant_entry_probe</code></div>
      </div>
   </section>

   <section>
      <h2>Examples</h2>
      <pre><code>import {'{'} runInteractionPattern, listInteractionPatterns {'}'} from 'a11ied';

// List all available patterns
const patterns = listInteractionPatterns();

// Run one pattern
const result = await runInteractionPattern({'{'}
  url: 'http://127.0.0.1:6173/landmarks.html',
  patternId: 'landmark_sequence',
  target: 'virtual',
{'}'});</code></pre>
   </section>

   <section>
      <h2>Why use patterns</h2>
      <ul>
         <li>Named, repeatable procedures instead of ad-hoc driver commands.</li>
         <li>Produce structured evidence blocks that the verification layer can consume.</li>
         <li>Make regressions easy to detect because the procedure stays consistent across runs.</li>
      </ul>
   </section>

   <section class="field-note">
      <h2>Evidence types</h2>
      <p>
         Some patterns produce fully automated evidence. Others produce hybrid evidence where a human
         needs to review part of the result. The output labels each pattern's evidence type so you
         know what level of review is needed.
      </p>
   </section>
</DocShell>
