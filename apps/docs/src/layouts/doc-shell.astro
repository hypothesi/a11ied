---
interface LinkItem {
   href: string;
   label: string;
}

interface Props {
   title: string;
   summary: string;
   links: LinkItem[];
}

const { title, summary, links } = Astro.props;
---

<html lang="en">
   <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>{title} | a11lied</title>
      <style>
         :root {
            color-scheme: light;
            --page-bg: #f7f4ea;
            --ink: #1f1f1b;
            --accent: #17606d;
            --accent-soft: rgba(23, 96, 109, 0.12);
            --muted: #625d57;
            --card: rgba(255, 255, 255, 0.76);
            --border: rgba(31, 31, 27, 0.1);
         }

         * {
            box-sizing: border-box;
         }

         body {
            margin: 0;
            min-height: 100vh;
            font-family: "IBM Plex Sans", "Avenir Next", sans-serif;
            background:
               radial-gradient(circle at top left, var(--accent-soft), transparent 32rem),
               linear-gradient(180deg, #fbfaf5 0%, var(--page-bg) 100%);
            color: var(--ink);
         }

         a {
            color: var(--accent);
         }

         main {
            width: min(76rem, calc(100% - 2rem));
            margin: 0 auto;
            padding: 2rem 0 4rem;
         }

         header {
            display: grid;
            gap: 1.25rem;
            margin-bottom: 2rem;
         }

         .brand {
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            color: var(--accent);
            font-size: 0.82rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
         }

         .summary {
            max-width: 48rem;
            font-size: 1.06rem;
            line-height: 1.65;
            color: var(--muted);
            margin: 0;
         }

         h1 {
            margin: 0;
            font-size: clamp(2.4rem, 6vw, 4.6rem);
            line-height: 0.96;
            letter-spacing: -0.05em;
         }

         nav {
            display: flex;
            flex-wrap: wrap;
            gap: 0.65rem;
         }

         nav a {
            padding: 0.65rem 0.9rem;
            border: 1px solid var(--border);
            border-radius: 999px;
            text-decoration: none;
            background: rgba(255, 255, 255, 0.58);
         }

         article {
            display: grid;
            gap: 1rem;
         }

         section {
            padding: 1.2rem;
            border: 1px solid var(--border);
            border-radius: 1.15rem;
            background: var(--card);
            backdrop-filter: blur(10px);
         }

         h2,
         h3 {
            margin-top: 0;
         }

         p,
         li {
            font-size: 1rem;
            line-height: 1.65;
         }

         ul,
         ol {
            margin: 0;
            padding-left: 1.25rem;
         }

         code,
         pre {
            font-family: "IBM Plex Mono", "SFMono-Regular", monospace;
         }

         pre {
            overflow-x: auto;
            padding: 1rem;
            border-radius: 0.9rem;
            background: #16252a;
            color: #f2f5f6;
         }

         .callout {
            border-left: 0.35rem solid var(--accent);
         }
      </style>
   </head>
   <body>
      <main>
         <header>
            <div class="brand">
               <a href="/">a11lied</a>
               <span>docs</span>
            </div>
            <div>
               <h1>{title}</h1>
               <p class="summary">{summary}</p>
            </div>
            <nav aria-label="Documentation">
               {links.map((link) => (
                  <a href={link.href}>{link.label}</a>
               ))}
            </nav>
         </header>
         <article>
            <slot />
         </article>
      </main>
   </body>
</html>
