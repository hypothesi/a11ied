---
interface LinkItem {
   href: string;
   label: string;
}

interface LinkSection {
   title: string;
   links: LinkItem[];
}

interface Props {
   title: string;
   summary: string;
   links: LinkSection[];
}

const { title, summary, links } = Astro.props;
const pathname = Astro.url.pathname;
const activeSection = links.find((section) =>
   section.links.some((link) => link.href === pathname),
);
---

<html lang="en">
   <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>{title} | a11ied</title>
      <style is:global>
         @import url("https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Spectral:wght@400;500;600&display=swap");

         :root {
            color-scheme: light;
            --page-bg: #ddd6c7;
            --page-glow: rgba(151, 80, 43, 0.16);
            --paper: #f6f0e6;
            --paper-deep: #efe6d9;
            --ink: #191512;
            --ink-soft: #493e37;
            --ink-faint: #685a50;
            --edge: rgba(25, 21, 18, 0.14);
            --edge-strong: rgba(25, 21, 18, 0.22);
            --steel: #1e2725;
            --steel-soft: #2b3633;
            --steel-ink: #f6efe3;
            --steel-muted: rgba(246, 239, 227, 0.76);
            --accent: #9a4a2a;
            --accent-soft: rgba(154, 74, 42, 0.14);
            --accent-pale: #e7d4c4;
            --warning: #6d2f1e;
            --shadow: 0 24px 48px rgba(35, 27, 21, 0.12);
            --space-2xs: 0.3rem;
            --space-xs: 0.55rem;
            --space-sm: 0.85rem;
            --space-md: 1.2rem;
            --space-lg: 1.8rem;
            --space-xl: 2.7rem;
            --space-2xl: 4rem;
         }

         * {
            box-sizing: border-box;
         }

         html {
            min-height: 100%;
            background:
               radial-gradient(circle at top left, var(--page-glow), transparent 22rem),
               radial-gradient(circle at right center, rgba(30, 39, 37, 0.08), transparent 28rem),
               var(--page-bg);
         }

         body {
            margin: 0;
            min-height: 100vh;
            font-family: "Spectral", Georgia, serif;
            color: var(--ink);
         }

         a {
            color: var(--accent);
            text-decoration-thickness: 0.08em;
            text-underline-offset: 0.14em;
         }

         .shell {
            width: min(91rem, calc(100% - 1.5rem));
            margin: 0.75rem auto;
            display: grid;
            grid-template-columns: minmax(16rem, 17.75rem) minmax(0, 1fr);
            gap: 1rem;
            align-items: start;
         }

         .desktop-rail {
            position: sticky;
            top: 0.75rem;
            min-height: calc(100vh - 1.5rem);
            padding: 1.4rem 1.2rem 1.5rem;
            border-radius: 1.35rem;
            background:
               linear-gradient(180deg, rgba(246, 239, 227, 0.05), transparent 18rem),
               var(--steel);
            color: var(--steel-ink);
            border: 1px solid rgba(0, 0, 0, 0.2);
            box-shadow: var(--shadow);
         }

         .mobile-bar {
            display: none;
         }

         .brand {
            display: grid;
            gap: var(--space-sm);
            margin-bottom: var(--space-lg);
         }

         .brand a {
            color: inherit;
            text-decoration: none;
         }

         .mark {
            width: 3.15rem;
            height: 3.15rem;
            display: grid;
            place-items: center;
            border-radius: 0.85rem;
            background:
               linear-gradient(140deg, rgba(154, 74, 42, 0.5), rgba(154, 74, 42, 0.12)),
               rgba(246, 239, 227, 0.06);
            font-family: "Barlow Condensed", Impact, sans-serif;
            font-size: 1.8rem;
            letter-spacing: 0.04em;
            text-transform: lowercase;
         }

         .brand-title {
            font-family: "Barlow Condensed", Arial Narrow, sans-serif;
            font-size: 2rem;
            line-height: 0.9;
            letter-spacing: 0.02em;
            text-transform: lowercase;
         }

         .brand-copy {
            margin: 0;
            max-width: 24ch;
            font-size: 1rem;
            line-height: 1.55;
            color: var(--steel-muted);
         }

         .rail-note {
            margin: 0 0 var(--space-lg);
            padding: var(--space-sm) 0 0;
            border-top: 1px solid rgba(246, 239, 227, 0.12);
            color: var(--steel-muted);
            font-size: 0.94rem;
            line-height: 1.55;
         }

         .rail-nav,
         .route-drawer-nav {
            display: grid;
            gap: var(--space-md);
         }

         .nav-section {
            display: grid;
            gap: 0.45rem;
         }

         .nav-title {
            font-family: "Barlow Condensed", Arial Narrow, sans-serif;
            font-size: 0.88rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: rgba(246, 239, 227, 0.58);
         }

         .route-drawer .nav-title {
            color: var(--ink-faint);
         }

         .nav-links {
            display: grid;
            gap: 0.3rem;
         }

         .nav-link {
            display: block;
            padding: 0.6rem 0.75rem;
            border-radius: 0.9rem;
            text-decoration: none;
            color: inherit;
            border: 1px solid transparent;
         }

         .desktop-rail .nav-link:hover,
         .desktop-rail .nav-link.active {
            background: rgba(246, 239, 227, 0.08);
            border-color: rgba(246, 239, 227, 0.1);
         }

         .route-drawer .nav-link {
            color: var(--ink);
         }

         .route-drawer .nav-link:hover,
         .route-drawer .nav-link.active {
            background: rgba(154, 74, 42, 0.08);
            border-color: rgba(154, 74, 42, 0.12);
         }

         .content {
            min-width: 0;
            padding: 1.15rem 0 4rem;
         }

         .content-frame {
            display: grid;
            gap: var(--space-xl);
         }

         header {
            display: grid;
            gap: var(--space-md);
         }

         .eyebrow-row {
            display: flex;
            flex-wrap: wrap;
            gap: 0.45rem;
         }

         .eyebrow,
         .context-chip,
         .tag {
            display: inline-flex;
            align-items: center;
            width: fit-content;
            padding: 0.34rem 0.65rem;
            border-radius: 999px;
            font-family: "Barlow Condensed", Arial Narrow, sans-serif;
            font-size: 0.92rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
         }

         .eyebrow {
            background: rgba(255, 248, 238, 0.86);
            border: 1px solid rgba(25, 21, 18, 0.08);
            color: var(--accent);
         }

         .context-chip {
            background: rgba(30, 39, 37, 0.08);
            border: 1px solid rgba(25, 21, 18, 0.08);
            color: var(--ink-soft);
         }

         .summary {
            max-width: 62ch;
            margin: 0;
            font-size: 1.12rem;
            line-height: 1.76;
            color: var(--ink-soft);
         }

         h1 {
            margin: 0;
            max-width: 14ch;
            font-family: "Barlow Condensed", Arial Narrow, sans-serif;
            font-size: clamp(3.2rem, 6vw, 5.8rem);
            line-height: 0.92;
            letter-spacing: 0.02em;
            text-transform: uppercase;
         }

         article {
            display: grid;
            gap: var(--space-xl);
         }

         section {
            display: grid;
            gap: var(--space-md);
            max-width: 72ch;
        }

         section > :last-child {
            margin-bottom: 0;
         }

         section.panel,
         section.ledger,
         section.field-note,
         section.split {
            max-width: none;
            padding: 1.15rem 1.2rem 1.25rem;
            border-radius: 1.15rem;
            border: 1px solid var(--edge);
            background: color-mix(in srgb, var(--paper) 88%, white);
            box-shadow: var(--shadow);
         }

         section.ledger {
            background: color-mix(in srgb, var(--paper-deep) 82%, white);
         }

         section.field-note {
            background:
               linear-gradient(180deg, rgba(30, 39, 37, 0.98), rgba(30, 39, 37, 0.94)),
               var(--steel);
            color: var(--steel-ink);
            border-color: rgba(0, 0, 0, 0.2);
         }

         section.split {
            grid-template-columns: minmax(0, 1.3fr) minmax(14rem, 0.9fr);
            align-items: start;
         }

         .panel-head {
            display: grid;
            gap: 0.35rem;
            padding-bottom: 0.9rem;
            border-bottom: 1px solid var(--edge);
         }

         .panel-kicker {
            margin: 0;
            font-family: "Barlow Condensed", Arial Narrow, sans-serif;
            font-size: 0.88rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--accent);
         }

         .field-note .panel-head {
            border-bottom-color: rgba(246, 239, 227, 0.14);
         }

         .field-note .panel-kicker {
            color: var(--accent-pale);
         }

         .field-note :is(h2, h3, p, li, a, code, strong) {
            color: inherit;
         }

         h2,
         h3 {
            margin: 0;
            font-family: "Barlow Condensed", Arial Narrow, sans-serif;
            letter-spacing: 0.03em;
            text-transform: uppercase;
         }

         h2 {
            font-size: clamp(1.9rem, 2.5vw, 2.5rem);
            line-height: 0.98;
         }

         h3 {
            font-size: 1.12rem;
            line-height: 1.05;
         }

         p,
         li {
            margin: 0;
            font-size: 1.04rem;
            line-height: 1.76;
         }

         ul,
         ol {
            margin: 0;
            padding-left: 1.15rem;
         }

         li + li,
         p + p {
            margin-top: 0.55rem;
         }

         strong {
            font-weight: 600;
         }

         code,
         pre {
            font-family:
               "SFMono-Regular",
               "SF Mono",
               "JetBrains Mono",
               "Fira Code",
               ui-monospace,
               monospace;
         }

         code {
            font-size: 0.9em;
         }

         pre {
            overflow-x: auto;
            margin: 0;
            padding: 1rem 1.05rem;
            border-radius: 1rem;
            background: #18211f;
            color: #f4ede3;
            border: 1px solid rgba(244, 237, 227, 0.12);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
         }

         .route-list,
         .workflow-list {
            display: grid;
            gap: 0.75rem;
         }

         .route-row,
         .workflow-row {
            display: grid;
            gap: 0.28rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid var(--edge);
         }

         .route-row:last-child,
         .workflow-row:last-child {
            padding-bottom: 0;
            border-bottom: 0;
         }

         .route-row span,
         .workflow-row span {
            color: var(--ink-soft);
         }

         .workflow-grid,
         .mini-grid {
            display: grid;
            gap: 1rem;
            grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
         }

         .stack {
            display: grid;
            gap: 0.75rem;
         }

         .stack > p,
         .stack > ul {
            color: var(--ink-soft);
         }

         .tag {
            background: var(--accent-soft);
            color: var(--accent);
         }

         .command-strip {
            display: grid;
            gap: 0.7rem;
         }

         .command-note,
         .aside-note,
         .support-copy {
            color: var(--ink-soft);
         }

         .split-aside {
            display: grid;
            gap: 0.8rem;
            padding-left: 1rem;
            border-left: 1px solid var(--edge);
         }

         .split-aside .tag {
            justify-self: start;
         }

         .mobile-bar {
            position: sticky;
            top: 0.55rem;
            z-index: 5;
            padding: 0.65rem 0.75rem;
            border-radius: 1rem;
            background: rgba(246, 240, 230, 0.94);
            border: 1px solid rgba(25, 21, 18, 0.12);
            box-shadow: var(--shadow);
            backdrop-filter: blur(10px);
         }

         .mobile-topline {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.8rem;
         }

         .mobile-brand {
            display: flex;
            align-items: center;
            gap: 0.7rem;
            min-width: 0;
         }

         .mobile-brand .mark {
            width: 2.35rem;
            height: 2.35rem;
            font-size: 1.35rem;
         }

         .mobile-brand-copy {
            display: grid;
            gap: 0.12rem;
            min-width: 0;
         }

         .mobile-brand-name,
         .mobile-brand-section {
            margin: 0;
            line-height: 1;
         }

         .mobile-brand-name {
            font-family: "Barlow Condensed", Arial Narrow, sans-serif;
            font-size: 1.3rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
         }

         .mobile-brand-section {
            font-size: 0.9rem;
            color: var(--ink-faint);
         }

         .route-drawer {
            margin-top: 0.65rem;
            border-top: 1px solid var(--edge);
            padding-top: 0.65rem;
         }

         .route-drawer summary {
            list-style: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.45rem;
            padding: 0.6rem 0.8rem;
            border-radius: 999px;
            background: rgba(154, 74, 42, 0.08);
            color: var(--accent);
            font-family: "Barlow Condensed", Arial Narrow, sans-serif;
            font-size: 1rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            cursor: pointer;
         }

         .route-drawer summary::-webkit-details-marker {
            display: none;
         }

         .route-drawer summary::after {
            content: "+";
            font-size: 1.1rem;
            line-height: 1;
         }

         .route-drawer[open] summary::after {
            content: "–";
         }

         .route-drawer-panel {
            display: grid;
            gap: 1rem;
            padding-top: 0.9rem;
         }

         .main-footer {
            max-width: 72ch;
            margin-top: var(--space-lg);
            padding-top: var(--space-sm);
            border-top: 1px solid var(--edge);
            color: var(--ink-faint);
            font-size: 0.97rem;
            line-height: 1.65;
         }

         @media (max-width: 980px) {
            .shell {
               grid-template-columns: 1fr;
               gap: 0.75rem;
               width: min(78rem, calc(100% - 1rem));
            }

            .desktop-rail {
               display: none;
            }

            .mobile-bar {
               display: block;
            }

            .content {
               padding-top: 0;
            }

            h1 {
               max-width: none;
               font-size: clamp(2.7rem, 10vw, 4.1rem);
            }
         }

         @media (max-width: 760px) {
            .content-frame {
               gap: 1.45rem;
            }

            section {
               gap: 0.95rem;
            }

            section.panel,
            section.ledger,
            section.field-note,
            section.split {
               padding: 1rem;
            }

            section.split {
               grid-template-columns: 1fr;
            }

            .split-aside {
               padding-left: 0;
               padding-top: 0.8rem;
               border-left: 0;
               border-top: 1px solid var(--edge);
            }

            .summary {
               font-size: 1rem;
            }

            p,
            li {
               font-size: 1rem;
            }
         }
      </style>
   </head>
   <body>
      <div class="shell">
         <aside class="desktop-rail">
            <div class="brand">
               <a href="/">
                  <div class="mark">a</div>
               </a>
               <div class="brand-title">
                  <a href="/">a11ied</a>
               </div>
               <p class="brand-copy">
                  Accessibility automation toolkit for real screen reader testing.
               </p>
            </div>
            <p class="rail-note">
               CLI, MCP server, and runtime reference for VoiceOver, NVDA, and virtual screen
               reader automation.
            </p>
            <nav class="rail-nav" aria-label="Documentation">
               {links.map((section) => (
                  <div class="nav-section">
                     <div class="nav-title">{section.title}</div>
                     <div class="nav-links">
                        {section.links.map((link) => (
                           <a
                              class:list={['nav-link', { active: pathname === link.href }]}
                              href={link.href}
                           >
                              {link.label}
                           </a>
                        ))}
                     </div>
                  </div>
               ))}
            </nav>
         </aside>
         <main class="content">
            <div class="content-frame">
               <div class="mobile-bar">
                  <div class="mobile-topline">
                     <div class="mobile-brand">
                        <a href="/">
                           <div class="mark">a</div>
                        </a>
                        <div class="mobile-brand-copy">
                           <p class="mobile-brand-name">a11ied</p>
                           <p class="mobile-brand-section">{activeSection?.title ?? 'Docs'}</p>
                        </div>
                     </div>
                  </div>
                  <details class="route-drawer">
                     <summary>Browse docs</summary>
                     <div class="route-drawer-panel">
                        <nav class="route-drawer-nav" aria-label="Documentation">
                           {links.map((section) => (
                              <div class="nav-section">
                                 <div class="nav-title">{section.title}</div>
                                 <div class="nav-links">
                                    {section.links.map((link) => (
                                       <a
                                          class:list={['nav-link', { active: pathname === link.href }]}
                                          href={link.href}
                                       >
                                          {link.label}
                                       </a>
                                    ))}
                                 </div>
                              </div>
                           ))}
                        </nav>
                     </div>
                  </details>
               </div>
               <header>
                  <div class="eyebrow-row">
                     <div class="eyebrow">a11ied docs</div>
                     {activeSection ? <div class="context-chip">{activeSection.title}</div> : null}
                  </div>
                  <div>
                     <h1>{title}</h1>
                     <p class="summary">{summary}</p>
                  </div>
               </header>
               <article>
                  <slot />
               </article>
               <div class="main-footer">
                  a11ied &mdash; open-source accessibility automation built on Guidepup.
               </div>
            </div>
         </main>
      </div>
   </body>
</html>
