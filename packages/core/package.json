{
   "name": "@a11ied/core",
   "version": "0.1.0",
   "files": [
      "dist",
      "scripts"
   ],
   "type": "module",
   "main": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      },
      "./scripts/*": "./scripts/*"
   },
   "publishConfig": {
      "access": "public"
   },
   "scripts": {
      "build": "tsup src/index.ts src/driver/broker.ts --format esm --dts --clean",
      "prepack": "npm run build",
      "typecheck": "tsc -p tsconfig.json --noEmit"
   },
   "dependencies": {
      "@a11ied/contracts": "0.1.0",
      "@a11ied/earl": "0.1.0",
      "@a11ied/guidepup": "0.1.0",
      "@a11ied/wcag-engine": "0.1.0",
      "@guidepup/record": "^0.1.0",
      "axe-core": "^4.13.0",
      "jsdom": "30.0.1",
      "playwright": "^1.62.1"
   }
}
