{
  "name": "@a11lied/storybook",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@a11lied/contracts": "0.1.0",
    "@a11lied/core": "0.1.0",
    "@guidepup/virtual-screen-reader": "^0.32.1"
  },
  "peerDependencies": {
    "storybook": "^10.3.4"
  }
}
