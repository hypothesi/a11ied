{
   "name": "@a11ied/verdict",
   "version": "0.1.0",
   "description": "Evaluation engine, verdict store, deduplication, and priority queue.",
   "files": [
      "dist"
   ],
   "type": "module",
   "main": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      }
   },
   "publishConfig": {
      "access": "public"
   },
   "scripts": {
      "build": "tsup src/index.ts --format esm --dts --clean",
      "typecheck": "tsc --noEmit"
   },
   "dependencies": {
      "@a11ied/contracts": "0.1.0",
      "@a11ied/knowledge": "0.1.0",
      "@a11ied/observe": "0.1.0",
      "@a11ied/wcag-engine": "0.1.0"
   }
}
