{
   "name": "@a11ied/report",
   "version": "0.1.0",
   "description": "VPAT, EARL, remediation roadmaps, and audit reporting.",
   "files": [
      "dist"
   ],
   "type": "module",
   "main": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      }
   },
   "publishConfig": {
      "access": "public"
   },
   "scripts": {
      "build": "tsup src/index.ts --format esm --dts --clean",
      "typecheck": "tsc --noEmit"
   },
   "dependencies": {
      "@a11ied/contracts": "0.1.0",
      "@a11ied/earl": "0.1.0",
      "@a11ied/observe": "0.1.0",
      "@a11ied/verdict": "0.1.0"
   }
}
