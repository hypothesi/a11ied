{
   "name": "@a11ied/guidepup",
   "version": "0.1.0",
   "description": "VoiceOver, NVDA, and simulated screen reader adapters. Internal package of a11ied, published because the a1 CLI depends on it. Its API can change in any release; install a11ied instead.",
   "homepage": "https://github.com/hypothesi/a11ied/tree/master/packages/guidepup#readme",
   "bugs": {
      "url": "https://github.com/hypothesi/a11ied/issues"
   },
   "license": "MIT",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/hypothesi/a11ied.git",
      "directory": "packages/guidepup"
   },
   "files": [
      "dist",
      "scripts",
      "CHANGELOG.md"
   ],
   "type": "module",
   "main": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      },
      "./browser": {
         "types": "./dist/browser.d.ts",
         "import": "./dist/browser.js"
      },
      "./virtual-page.js": "./dist/virtual-page.js",
      "./scripts/*": "./scripts/*"
   },
   "publishConfig": {
      "access": "public"
   },
   "scripts": {
      "build": "rimraf dist && tsup",
      "prepack": "npm run build",
      "typecheck": "tsc -p tsconfig.json --noEmit"
   },
   "dependencies": {
      "@a11ied/contracts": "0.1.0",
      "@guidepup/guidepup": "^0.33.2",
      "@guidepup/virtual-screen-reader": "^0.32.1",
      "dom-accessibility-api": "0.7.1",
      "jsdom": "^30.0.1",
      "proper-lockfile": "4.1.2",
      "zod": "^4.6.6"
   },
   "devDependencies": {
      "@types/proper-lockfile": "4.1.4"
   },
   "engines": {
      "node": ">=24"
   }
}
