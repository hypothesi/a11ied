{
   "name": "@a11ied/wcag-data",
   "version": "0.3.0",
   "description": "Normalized WCAG, ACT, and APG data. Internal package of a11ied, published because the a1 CLI depends on it. Its API can change in any release; install a11ied instead.",
   "homepage": "https://github.com/hypothesi/a11ied/tree/master/packages/wcag-data#readme",
   "bugs": {
      "url": "https://github.com/hypothesi/a11ied/issues"
   },
   "license": "MIT",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/hypothesi/a11ied.git",
      "directory": "packages/wcag-data"
   },
   "files": [
      "dist",
      "data/generated",
      "NOTICE.md",
      "CHANGELOG.md"
   ],
   "type": "module",
   "main": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
   },
   "publishConfig": {
      "access": "public"
   },
   "scripts": {
      "build": "tsup src/index.ts --format esm --dts --clean",
      "generate": "tsx scripts/refresh-strategy.ts",
      "prepack": "npm run build",
      "sync": "tsx scripts/sync.ts",
      "typecheck": "tsc -p tsconfig.json --noEmit",
      "validate": "tsx scripts/validate.ts"
   },
   "dependencies": {
      "@a11ied/contracts": "0.3.0",
      "axe-core": "^4.13.0",
      "jsdom": "30.0.1",
      "turndown": "7.2.4",
      "yaml": "^2.9.0"
   },
   "devDependencies": {
      "@types/turndown": "5.0.6"
   },
   "engines": {
      "node": ">=24"
   }
}
