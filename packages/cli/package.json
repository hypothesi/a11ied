{
   "name": "a11ied",
   "version": "0.1.0",
   "bin": {
      "a1": "./dist/cli.js",
      "a11ied": "./dist/cli.js"
   },
   "files": [
      "dist"
   ],
   "type": "module",
   "types": "./dist/index.d.ts",
   "imports": {
      "#contracts": "./src/bridges/contracts.ts",
      "#core": "./src/bridges/core.ts",
      "#mcp-server": "./src/bridges/mcp-server.ts"
   },
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      },
      "./test": {
         "types": "./dist/test.d.ts",
         "import": "./dist/test.js"
      },
      "./vitest": {
         "types": "./dist/vitest.d.ts",
         "import": "./dist/vitest.js"
      },
      "./browser": {
         "types": "./dist/browser.d.ts",
         "import": "./dist/browser.js"
      }
   },
   "scripts": {
      "build": "rimraf dist && tsup",
      "prepack": "npm run build",
      "typecheck": "tsc -p tsconfig.json --noEmit"
   },
   "dependencies": {
      "@a11ied/contracts": "^0.1.0",
      "@a11ied/core": "0.1.0",
      "@a11ied/mcp-server": "0.1.0",
      "chalk": "6.0.0",
      "clipboardy": "5.3.2",
      "commander": "^15.0.0",
      "ink": "7.1.1",
      "react": "19.2.8",
      "string-width": "8.1.0",
      "wrap-ansi": "10.0.1"
   },
   "devDependencies": {
      "@types/react": "19.2.18"
   },
   "peerDependencies": {
      "vitest": ">=4.0.0"
   },
   "peerDependenciesMeta": {
      "vitest": {
         "optional": true
      }
   }
}
