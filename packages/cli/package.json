{
   "name": "a11ied",
   "version": "0.1.0",
   "bin": {
      "a11ied": "./dist/cli.js"
   },
   "files": [
      "dist"
   ],
   "type": "module",
   "types": "./dist/index.d.ts",
   "imports": {
      "#contracts": "./src/bridges/contracts.ts",
      "#core": "./src/bridges/core.ts",
      "#mcp-server": "./src/bridges/mcp-server.ts"
   },
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      }
   },
   "scripts": {
      "build": "tsup src/index.ts src/cli.ts --format esm --clean --external=@guidepup/guidepup --external=@guidepup/setup --external=@guidepup/virtual-screen-reader --external=@guidepup/record --external=playwright --external=playwright-core --external=chromium-bidi --external=chromium-bidi/lib/cjs/bidiMapper/BidiMapper --external=chromium-bidi/lib/cjs/cdp/CdpConnection --external=jsdom --external=axe-core --external=@modelcontextprotocol/sdk",
      "typecheck": "tsc -p ../../tsconfig.typecheck.json --noEmit"
   },
   "dependencies": {
      "@a11ied/contracts": "^0.1.0",
      "@a11ied/core": "0.1.0",
      "@a11ied/mcp-server": "0.1.0",
      "@clack/prompts": "^1.2.0",
      "commander": "^14.0.3"
   }
}
