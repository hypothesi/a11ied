{
   "name": "a11ied",
   "version": "0.1.0",
   "bin": {
      "a1": "./dist/cli.js",
      "a11ied": "./dist/cli.js"
   },
   "files": [
      "dist"
   ],
   "type": "module",
   "types": "./dist/index.d.ts",
   "imports": {
      "#contracts": "./src/bridges/contracts.ts",
      "#core": "./src/bridges/core.ts",
      "#mcp-server": "./src/bridges/mcp-server.ts"
   },
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      }
   },
   "scripts": {
      "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean --external=@guidepup/guidepup --external=@guidepup/setup --external=@guidepup/virtual-screen-reader --external=@guidepup/record --external=playwright --external=playwright-core --external=chromium-bidi --external=chromium-bidi/lib/cjs/bidiMapper/BidiMapper --external=chromium-bidi/lib/cjs/cdp/CdpConnection --external=jsdom --external=axe-core --external=@modelcontextprotocol/sdk",
      "prepack": "npm run build",
      "typecheck": "tsc -p tsconfig.json --noEmit"
   },
   "dependencies": {
      "@a11ied/contracts": "^0.1.0",
      "@a11ied/core": "0.1.0",
      "@a11ied/mcp-server": "0.1.0",
      "chalk": "6.0.0",
      "clipboardy": "5.3.2",
      "commander": "^15.0.0",
      "ink": "7.1.1",
      "react": "19.2.8",
      "wrap-ansi": "10.0.1"
   },
   "devDependencies": {
      "@types/react": "19.2.18"
   }
}
