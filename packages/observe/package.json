{
   "name": "@a11ied/observe",
   "version": "0.3.0",
   "description": "Browser observation, page probes, and contrast sampling. Internal package of a11ied, published because the a1 CLI depends on it. Its API can change in any release; install a11ied instead.",
   "homepage": "https://github.com/hypothesi/a11ied/tree/master/packages/observe#readme",
   "bugs": {
      "url": "https://github.com/hypothesi/a11ied/issues"
   },
   "license": "MIT",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/hypothesi/a11ied.git",
      "directory": "packages/observe"
   },
   "files": [
      "dist",
      "CHANGELOG.md"
   ],
   "type": "module",
   "main": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      }
   },
   "publishConfig": {
      "access": "public"
   },
   "scripts": {
      "build": "tsup src/index.ts --format esm --dts --clean",
      "typecheck": "tsc --noEmit",
      "prepack": "npm run build"
   },
   "dependencies": {
      "@a11ied/contracts": "0.3.0",
      "playwright": "^1.62.1",
      "proper-lockfile": "4.1.2",
      "yaml": "2.8.3",
      "zod": "^4.6.6"
   },
   "devDependencies": {
      "@types/proper-lockfile": "4.1.4"
   },
   "engines": {
      "node": ">=24"
   }
}
