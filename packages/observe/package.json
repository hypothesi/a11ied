{
   "name": "@a11ied/observe",
   "version": "0.1.0",
   "description": "Deterministic browser observation, page probes, contrast sampling, and content-addressed cache.",
   "files": [
      "dist"
   ],
   "type": "module",
   "main": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      }
   },
   "publishConfig": {
      "access": "public"
   },
   "scripts": {
      "build": "tsup src/index.ts --format esm --dts --clean",
      "typecheck": "tsc --noEmit"
   },
   "dependencies": {
      "@a11ied/contracts": "0.1.0",
      "@a11ied/knowledge": "0.1.0",
      "axe-core": "^4.13.0",
      "playwright": "^1.62.1",
      "proper-lockfile": "4.1.2",
      "yaml": "2.8.3",
      "zod": "^4.6.6"
   },
   "devDependencies": {
      "@types/proper-lockfile": "4.1.4"
   }
}
