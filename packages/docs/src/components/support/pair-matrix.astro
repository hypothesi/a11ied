---
import InfoTip from '../info-tip.astro';
import PlatformIcon from './platform-icon.astro';
import { BROWSER_FAMILIES } from '../../lib/platforms';
import { formatSharePercentages, getHeatLevel, type MatrixRow } from '../../lib/support-share';

interface Props {
   readonly rows: readonly MatrixRow[];
}

const { rows } = Astro.props;

function formatFeatureCount(count: number): string {
   return `${String(count)} ${count === 1 ? 'feature' : 'features'}`;
}
---

<section class="pairMatrix" aria-labelledby="pair-matrix-heading">
   <div class="pairMatrix-headingRow">
      <h2 id="pair-matrix-heading" class="pairMatrix-heading">Best browser for each screen reader</h2>
      <InfoTip term="Best browser for each screen reader" glossaryTerm="Support score">
         Each percentage is the share of tests that pass, fully or partially, for that screen
         reader in that browser. It is averaged over features, using each test's latest result.
      </InfoTip>
   </div>
   <div class="pairMatrix-wrap" tabindex="0" role="region" aria-labelledby="pair-matrix-heading">
      <table class="pairMatrix-table">
         <thead>
            <tr>
               <th scope="col">Screen reader</th>
               {BROWSER_FAMILIES.map((family) => (
                  <th scope="col">
                     <span class="pairMatrix-colHead">
                        <PlatformIcon browser={family} size={18} />
                        {family}
                     </span>
                  </th>
               ))}
            </tr>
         </thead>
         <tbody>
            {rows.map((row) => (
               <tr>
                  <th scope="row">
                     <span class="pairMatrix-rowHead">
                        <PlatformIcon os={row.os} size={18} />
                        <span>
                           {row.screenReader}
                           <span class="pairMatrix-os">{row.os}</span>
                           {row.sharedFeatureCount > 0 && (
                              <span class="pairMatrix-basis">
                                 Compared on {formatFeatureCount(row.sharedFeatureCount)}
                                 <InfoTip term={`Compared on ${formatFeatureCount(row.sharedFeatureCount)}`}>
                                    Browsers were tested on different features, so this row compares
                                    them only on the {row.sharedFeatureCount} tested in every browser.
                                    A second, smaller percentage covers every feature that browser was
                                    tested on, and is not comparable with the others.
                                 </InfoTip>
                              </span>
                           )}
                        </span>
                     </span>
                  </th>
                  {row.cells.map((cell) => {
                     if (cell.state === 'unavailable') {
                        return <td class="pairMatrix-cell pairMatrix-cell--empty">Not available</td>;
                     }
                     if (cell.state === 'untested') {
                        return <td class="pairMatrix-cell pairMatrix-cell--empty">Not tested</td>;
                     }

                     const isCompared = row.sharedFeatureCount > 0;
                     const mainShare = isCompared ? cell.sharedShare : cell.share;
                     const hasMoreFeatures = isCompared && cell.share.pairCount > row.sharedFeatureCount;

                     return (
                        <td class={`pairMatrix-cell pairMatrix-cell--${getHeatLevel(mainShare)}`}>
                           <span class="pairMatrix-score">
                              <strong class="pairMatrix-pct">{formatSharePercentages(mainShare).total}</strong>
                              {cell.isBest && <span class="pairMatrix-best">Best</span>}
                           </span>
                           {hasMoreFeatures && (
                              <span class="pairMatrix-all">
                                 {formatSharePercentages(cell.share).total} across all {formatFeatureCount(cell.share.pairCount)}
                              </span>
                           )}
                           {!isCompared && <span class="pairMatrix-all">{formatFeatureCount(mainShare.pairCount)} tested</span>}
                        </td>
                     );
                  })}
               </tr>
            ))}
         </tbody>
      </table>
   </div>
</section>

<style>
.pairMatrix {
   display: flex;
   flex-direction: column;
   gap: 0.6rem;
}

.pairMatrix-headingRow {
   display: flex;
   align-items: center;
   gap: 0.4rem;
}

.pairMatrix-heading {
   margin: 0;
   padding-top: 0;
   border-top: 0;
   font-size: 1.3rem;
}


.pairMatrix-wrap {
   overflow-x: auto;
   border: 1px solid color-mix(in oklch, var(--ink) 18%, transparent);
   border-radius: 4px;
   background: var(--paper-light);
}

.pairMatrix-table {
   inline-size: 100%;
   border-collapse: collapse;
   font-size: 0.88rem;
}

.pairMatrix-table th,
.pairMatrix-table td {
   padding: 0.55rem 0.7rem;
   border-bottom: 1px solid color-mix(in oklch, var(--ink) 12%, transparent);
   text-align: start;
   vertical-align: middle;
}

.pairMatrix-table tbody tr:last-child th,
.pairMatrix-table tbody tr:last-child td {
   border-bottom: 0;
}

.pairMatrix-table thead th {
   font-family: var(--display);
   font-size: 0.78rem;
   letter-spacing: 0.04em;
   text-transform: uppercase;
   white-space: nowrap;
}

.pairMatrix-colHead,
.pairMatrix-rowHead {
   display: inline-flex;
   align-items: center;
   gap: 0.4rem;
}

.pairMatrix-rowHead {
   white-space: nowrap;
}

.pairMatrix-os {
   display: block;
   font-size: 0.76rem;
   font-weight: 400;
   color: var(--ink-soft);
}

.pairMatrix-cell {
   min-inline-size: 7.5rem;
}

.pairMatrix-cell--high {
   background: color-mix(in oklch, #1e7a46 16%, transparent);
}

.pairMatrix-cell--mid {
   background: color-mix(in oklch, #d97706 16%, transparent);
}

.pairMatrix-cell--low {
   background: color-mix(in oklch, #bd2b26 13%, transparent);
}

.pairMatrix-cell--empty {
   font-size: 0.8rem;
   color: var(--ink-soft);
}

.pairMatrix-score {
   display: flex;
   align-items: center;
   gap: 0.4rem;
}

.pairMatrix-basis {
   display: block;
   margin-block-start: 0.15rem;
   font-size: 0.74rem;
   font-weight: 400;
   color: var(--ink-soft);
}

.pairMatrix-pct {
   font-family: var(--display);
   font-size: 1.15rem;
   font-variant-numeric: tabular-nums;
   line-height: 1.1;
}


.pairMatrix-all {
   display: block;
   margin-block-start: 0.2rem;
   font-size: 0.74rem;
   color: var(--ink-soft);
}

.pairMatrix-best {
   padding: 0.05rem 0.35rem;
   border-radius: 3px;
   background: var(--ink);
   color: var(--paper);
   font-family: var(--display);
   font-size: 0.68rem;
   font-weight: 700;
   letter-spacing: 0.05em;
   text-transform: uppercase;
}
</style>
