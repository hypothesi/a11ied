---
import { formatSharePercentages, listShareSegments, type SupportShare } from '../../lib/support-share';
import InfoTip from '../info-tip.astro';
import SegmentBar from './segment-bar.astro';

interface Props {
   readonly share: SupportShare;
   readonly size?: 'compact' | 'large';
}

const { share, size = 'compact' } = Astro.props;
const percentages = formatSharePercentages(share);
const pairLabel = share.pairCount === 1 ? 'pair' : 'pairs';
const hasPartial = share.partialScore > 0;
---

<div class={`supportShare supportShare--${size}`}>
   {share.pairCount > 0 ? (
      <>
         <p class="supportShare-label">
            Support
            <InfoTip term="Support" glossaryTerm="Support score">
               The average score of the {share.pairCount} screen reader and browser {pairLabel}
               tested. A pair's score is the share of its tests that pass on their latest run.
            </InfoTip>
         </p>
         <p class="supportShare-value">
            <strong class="supportShare-total">{percentages.total}</strong>
            {hasPartial && (
               <span class="supportShare-breakdown">
                  <span class="supportShare-full">{percentages.supported} full</span>
                  {' · '}
                  <span class="supportShare-partial">{percentages.partial} partial</span>
               </span>
            )}
         </p>
         {size === 'large' && <SegmentBar segments={listShareSegments(share)} />}
      </>
   ) : (
      <p class="supportShare-label">Not tested with a real screen reader</p>
   )}
</div>

<style>
.supportShare {
   display: flex;
   flex-direction: column;
   gap: 0.15rem;
}

.supportShare p {
   margin: 0;
}

/*
 * When the parent is a grid, the label, value, and bar rows line up with the card next to
 * it, so both bars sit at the same height.
 */
.supportShare--large {
   display: grid;
   grid-row: span 3;
   grid-template-rows: subgrid;
   row-gap: 0.4rem;
}

.supportShare-value {
   display: flex;
   flex-wrap: wrap;
   align-items: baseline;
   align-self: end;
   gap: 0.1rem 0.6rem;
}

.supportShare-label {
   font-family: var(--display);
   font-size: 0.74rem;
   font-weight: 700;
   letter-spacing: 0.05em;
   text-transform: uppercase;
   color: var(--ink-soft);
}

.supportShare-total {
   font-family: var(--display);
   font-size: 1.15rem;
   font-weight: 700;
   font-variant-numeric: tabular-nums;
   line-height: 1.15;
   color: var(--ink);
}

.supportShare--large .supportShare-total {
   font-size: 1.65rem;
}

.supportShare-breakdown {
   font-size: 0.8rem;
   font-variant-numeric: tabular-nums;
   color: var(--ink-soft);
}

.supportShare-full {
   color: #1e7a46;
}

.supportShare-partial {
   color: #a15c00;
}
</style>
