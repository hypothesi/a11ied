---
import { formatSharePercentages, type SupportShare } from '../../lib/support-share';

interface Props {
   readonly share: SupportShare;
   readonly size?: 'compact' | 'large';
}

const { share, size = 'compact' } = Astro.props;
const percentages = formatSharePercentages(share);
const pairLabel = share.pairCount === 1 ? 'pair' : 'pairs';
const spokenSummary = `Supported by ${percentages.total} of tested pairs: ${percentages.supported} fully and ${percentages.partial} partially.`;
---

<div class={`supportShare supportShare--${size}`}>
   {share.pairCount > 0 ? (
      <>
         <p class="supportShare-label">Support <span>% of tested pairs</span></p>
         <p class="supportShare-figures" aria-hidden="true">
            <span class="supportShare-full">{percentages.supported}</span>
            <span class="supportShare-op">+</span>
            <span class="supportShare-partial">{percentages.partial}</span>
            <span class="supportShare-op">=</span>
            <strong class="supportShare-total">{percentages.total}</strong>
         </p>
         <p class="supportShare-hidden">{spokenSummary}</p>
         <p class="supportShare-note">
            Supported + partial, averaged over {share.pairCount} screen reader and browser
            {pairLabel}. Each pair counts once, scored by the share of its tests that pass, using
            the latest result of each test.
         </p>
      </>
   ) : (
      <p class="supportShare-label">Not tested with a real screen reader</p>
   )}
</div>

<style>
.supportShare {
   display: flex;
   flex-direction: column;
   gap: 0.15rem;
}

.supportShare p {
   margin: 0;
}

.supportShare-label {
   font-family: var(--display);
   font-size: 0.74rem;
   font-weight: 700;
   letter-spacing: 0.05em;
   text-transform: uppercase;
   color: var(--ink-soft);
}

.supportShare-label span {
   font-weight: 400;
   text-transform: none;
   letter-spacing: 0;
}

.supportShare-figures {
   display: flex;
   flex-wrap: wrap;
   align-items: baseline;
   gap: 0.35rem;
   font-family: var(--display);
   font-size: 1.15rem;
   font-variant-numeric: tabular-nums;
   line-height: 1.15;
}

.supportShare--large .supportShare-figures {
   font-size: 1.65rem;
}

.supportShare-full {
   color: #1e7a46;
}

.supportShare-partial {
   color: #a15c00;
}

.supportShare-op {
   color: var(--ink-soft);
}

.supportShare-total {
   color: var(--ink);
}

.supportShare-note {
   max-inline-size: 32ch;
   font-size: 0.76rem;
   line-height: 1.35;
   color: var(--ink-soft);
}

.supportShare--large .supportShare-note {
   max-inline-size: 60ch;
   font-size: 0.82rem;
}

.supportShare-hidden {
   position: absolute;
   overflow: hidden;
   inline-size: 1px;
   block-size: 1px;
   margin: -1px;
   padding: 0;
   border: 0;
   clip-path: inset(50%);
   white-space: nowrap;
}
</style>
