---
import DocShell from '../../layouts/doc-shell.astro';
import { docsLinks } from '../../lib/nav';

const toc = [
   { id: 'how', label: 'How an audit works' },
   { id: 'start', label: 'Start one' },
   { id: 'scope', label: 'Choose the scope' },
   { id: 'split', label: 'Automated and judged' },
   { id: 'workers', label: 'Run the workers' },
   { id: 'track', label: 'Track progress' },
