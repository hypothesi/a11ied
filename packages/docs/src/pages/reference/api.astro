---
import DocShell from '../../layouts/doc-shell.astro';
import { docsLinks } from '../../lib/nav';

const testSample = [
   `import { queuedScreenReader } from 'a11ied/test';`,
   '',
   `await using sr = await queuedScreenReader({ url: 'http://localhost:3000/checkout' });`,
   '',
   `sr.goTo({ role: 'button', name: 'Pay' });`,
   'sr.activate();',
   'sr.expectSpoken(/order placed/iu);',
].join('\n');
const axeSample = [
   `import { runAxe } from 'a11ied';`,
   '',
   'const result = await runAxe(',
   `   { kind: 'goto', url: 'http://localhost:3000/checkout' },`,
   `   { wcagVersion: '2.2', level: 'AA' },`,
   ');',
   '',
   'for (const violation of result.violations) {',
   '   console.log(violation.id, violation.impact, violation.nodes[0]?.target);',
   '}',
].join('\n');
const wcagSample = [
   `import { listWcagCriteria, searchWcagCriteria, showWcagCriterion } from 'a11ied';`,
   '',
   `const { criterion, testMethod, strategy } = showWcagCriterion('4.1.3', '2.2');`,
   '',
   'console.log(criterion.title, testMethod.method, strategy.requiresRealTarget);',
   '',
   `const levelAA = listWcagCriteria('AA', '2.2');`,
   `const matches = searchWcagCriteria('focus order', { version: '2.2', limit: 3 });`,
].join('\n');
const relevanceSample = [
   `import { inspectCriterionUrl, inspectRelevantCriteriaUrl } from 'a11ied';`,
   '',
   `const matrix = await inspectRelevantCriteriaUrl('http://localhost:3000', '2.2');`,
   `const focusOrder = await inspectCriterionUrl('2.4.3', 'http://localhost:3000', '2.2');`,
   '',
   'console.log(focusOrder.assessment.state, focusOrder.assessment.reasons);',
].join('\n');
const doctorSample = [
   `import { createDoctorReport, renderDoctorText, resolveAvailableDefaultTarget } from 'a11ied';`,
   '',
   'const report = createDoctorReport();',
   '',
   'console.log(report.ready, renderDoctorText(report));',
   '',
   'const { target, targetType, warning } = await resolveAvailableDefaultTarget();',
].join('\n');
const driverSample = [
   'import {',
   '   attachDocumentToDriverSession,',
   '   resolveDocumentTarget,',
   '   runDriverSessionAction,',
   '   startDriverSession,',
   '   stopDriverSession,',
   `} from 'a11ied';`,
   '',
   `const url = 'http://localhost:3000/checkout';`,
   'const target = await resolveDocumentTarget({ url });',
   '',
   `await startDriverSession({ target: 'virtual' });`,
   'await attachDocumentToDriverSession({ html: await target.readHtml(), url });',
   '',
   'try {',
   `   const result = await runDriverSessionAction({ action: 'next', payload: { kind: 'heading' } });`,
   '',
   '   console.log(result.state.lastSpokenPhrase);',
   '} finally {',
   '   await stopDriverSession();',
   '}',
].join('\n');
const pageSample = [
   `import { runAxe, withInteractiveBrowserPage } from 'a11ied';`,
   `import { screenReader } from 'a11ied/test';`,
   '',
   `await withInteractiveBrowserPage('http://localhost:3000/account', async (page) => {`,
   '   await using sr = await screenReader({ page });',
   '',
   `   await sr.next('heading');`,
   `   return runAxe({ kind: 'goto', url: page.url() }, { wcagVersion: '2.2', level: 'AA', page });`,
   '});',
].join('\n');
const auditSample = [
   `import { addPage, claimNext, startAudit } from 'a11ied';`,
   '',
   `const audit = startAudit({ target: 'https://example.com', criteria: ['2.4.7'] });`,
   '',
   `addPage(audit, { locator: 'https://example.com/' });`,
   `const unit = claimNext(audit, { worker: 'w1' });`,
].join('\n');
const toc = [
   { id: 'install', label: 'Install' },
   { id: 'test', label: 'Screen reader tests' },
   { id: 'axe', label: 'Scans' },
   { id: 'wcag', label: 'WCAG lookups' },
   { id: 'relevance', label: 'Relevant criteria' },
   { id: 'doctor', label: 'Machine checks' },
   { id: 'page', label: 'One page for scan and reader' },
   { id: 'driver', label: 'Sessions' },
   { id: 'audit', label: 'Audits' },
   { id: 'errors', label: 'Errors' },
   { id: 'packages', label: 'Packages' },
];
---

<DocShell
   title="TypeScript API"
   summary="<p>The functions behind the CLI, for use in your own code. <code>a11ied/test</code> has the screen reader test API. <code>a11ied</code> has scans, WCAG lookups, sessions, and audits.</p>"
   links={docsLinks}
   toc={toc}
>
   <section>
      <h2 id="install">Install</h2>
      <pre><code>npm install a11ied</code></pre>
      <p>The package is ESM with type declarations. It has four entry points.</p>
      <dl class="defs">
         <dt><code>a11ied</code></dt>
         <dd>Scans, lookups, sessions, audits, and machine checks.</dd>
         <dt><code>a11ied/test</code></dt>
         <dd>The screen reader test API, for any test runner.</dd>
         <dt><code>a11ied/vitest</code></dt>
         <dd>The same, as a Vitest fixture with matchers. Needs Vitest 4 or later.</dd>
         <dt><code>a11ied/browser</code></dt>
         <dd>The same, for Vitest browser mode.</dd>
      </dl>
      <p>
         Import only from these four. Paths inside the package change between releases.
      </p>
   </section>

   <section>
      <h2 id="test">Screen reader tests</h2>
      <pre data-label="TypeScript"><code>{testSample}</code></pre>
      <p>
         The guides cover this API: <a href="/guides/testing">write screen reader tests</a>
         and <a href="/guides/vitest">test with Vitest</a>.
      </p>
      <dl class="defs defs--wide">
         <dt><code>screenReader(options?)</code></dt>
         <dd>Starts a reader and returns a <code>ScreenReader</code>. Every method returns a promise.</dd>
         <dt><code>queuedScreenReader(options?)</code></dt>
         <dd>Starts a reader and returns a <code>QueuedScreenReader</code>. A call queues a command, and awaiting a call runs everything queued before it.</dd>
         <dt><code>queueScreenReader(reader)</code></dt>
         <dd>Wraps a <code>ScreenReader</code> that is already started.</dd>
         <dt><code>ScreenReaderAssertionError</code></dt>
         <dd>Thrown by the <code>expect</code> methods, <code>wait</code>, <code>find</code>, and <code>goTo</code>. Has <code>expected</code>, <code>phrases</code>, and <code>exitCode: 4</code>.</dd>
      </dl>
      <h3>Options</h3>
      <dl class="defs">
         <dt><code>url</code>, <code>html</code></dt>
         <dd>The page to read.</dd>
         <dt><code>sr</code></dt>
         <dd><code>'virtual'</code>, the default, <code>'voiceover'</code>, or <code>'nvda'</code>.</dd>
         <dt><code>mode</code></dt>
         <dd><code>'in-process'</code>, the default, or <code>'broker'</code> to share the session with <code>a1 sr</code>.</dd>
         <dt><code>engine</code></dt>
         <dd><code>'browser'</code> or <code>'jsdom'</code>, for the simulated screen reader.</dd>
         <dt><code>page</code></dt>
         <dd>A Playwright page to read, in place of a URL. Simulated and in-process only.</dd>
         <dt><code>browser</code></dt>
         <dd>The browser a VoiceOver or NVDA session opens the page in.</dd>
         <dt><code>container</code></dt>
         <dd>In <code>a11ied/browser</code>, the element to read.</dd>
         <dt><code>recordingPath</code></dt>
         <dd>Record the screen, with VoiceOver or NVDA.</dd>
         <dt><code>timeoutMs</code>, <code>idleTimeoutMinutes</code>, <code>nativeInput</code></dt>
         <dd>As the <a href="/reference/cli#sr"><code>a1 sr start</code></a> options.</dd>
      </dl>
      <h3>Methods</h3>
      <dl class="defs">
         <dt>Move</dt>
         <dd><code>next</code>, <code>previous</code>, <code>top</code>, <code>bottom</code>, <code>goTo</code>, <code>find</code>, <code>table</code>, <code>open</code></dd>
         <dt>Read</dt>
         <dd><code>read</code>, <code>title</code>, <code>elements</code>, <code>readAll</code>, <code>walk</code>, <code>transcript</code>, <code>state</code></dd>
         <dt>Act</dt>
         <dd><code>activate</code>, <code>press</code>, <code>type</code>, <code>escape</code>, <code>interact</code>, <code>stopInteracting</code>, <code>perform</code>, <code>focus</code>, <code>screenshot</code></dd>
         <dt>Check</dt>
         <dd><code>checkpoint</code>, <code>wait</code>, <code>expectSpoken</code>, <code>expectCursorOn</code>, <code>expectSpokenInOrder</code></dd>
         <dt>End</dt>
         <dd><code>stop</code>, and <code>Symbol.asyncDispose</code> for <code>await using</code>. A queued reader adds <code>drain</code>.</dd>
      </dl>
   </section>

   <section>
      <h2 id="axe">Scans</h2>
      <pre data-label="TypeScript"><code>{axeSample}</code></pre>
      <dl class="defs defs--wide">
         <dt><code>runAxe(load, options)</code></dt>
         <dd>Runs axe-core. <code>load</code> is <code>&#123; kind: 'goto', url &#125;</code> or <code>&#123; kind: 'html', html &#125;</code>. Give one of <code>level</code>, <code>criterion</code>, or <code>ruleIds</code>, or none to run every mapped rule. Returns <code>violations</code>, <code>passes</code>, <code>incomplete</code>, <code>inapplicable</code>, the <code>ruleIds</code> that ran, and <code>warnings</code>. The CLI and the MCP tools add the pass or fail verdict.</dd>
         <dt><code>runPageCheck(input)</code></dt>
         <dd>What <code>a1 check</code> runs: the scan, the tree summary, and the relevant criteria.</dd>
         <dt><code>resolveDocumentTarget(input)</code></dt>
         <dd>Turns a URL, a file path, <code>-</code>, or <code>&#123; html &#125;</code> into something to load, as the CLI does for its page argument.</dd>
      </dl>
   </section>

   <section>
      <h2 id="wcag">WCAG lookups</h2>
      <pre data-label="TypeScript"><code>{wcagSample}</code></pre>
      <dl class="defs defs--wide">
         <dt><code>showWcagCriterion(key, version)</code></dt>
         <dd>One criterion with its <code>testMethod</code>, <code>strategy</code>, and mobile guidance. <code>key</code> is a number or a slug.</dd>
         <dt><code>showWcagTestMethod(key, version)</code></dt>
         <dd>The criterion with its test method and strategy only.</dd>
         <dt><code>listWcagCriteria(level, version)</code></dt>
         <dd>The criteria at one level. Pass <code>undefined</code> for all.</dd>
         <dt><code>searchWcagCriteria(query, options)</code></dt>
         <dd>Ranked matches.</dd>
         <dt><code>showWcagTechnique(id, version)</code></dt>
         <dd>A technique or failure, such as <code>G18</code>, and the criteria that list it.</dd>
         <dt><code>showWcagTestMethodSummary(version)</code></dt>
         <dd>Counts by test method per level.</dd>
         <dt><code>showWcagAxeRule(ruleId, version)</code></dt>
         <dd>The criteria an axe rule tests. This one is asynchronous.</dd>
      </dl>
      <p>These read data that ships in the package and make no network request.</p>
   </section>

   <section>
      <h2 id="relevance">Relevant criteria</h2>
      <pre data-label="TypeScript"><code>{relevanceSample}</code></pre>
      <p>
         <code>inspectRelevantCriteriaTarget</code> and <code>inspectCriterionTarget</code>
         take a resolved target in place of a URL. See
         <a href="/relevant-criteria">relevant criteria</a> for the states.
      </p>
   </section>

   <section>
      <h2 id="doctor">Machine checks</h2>
      <pre data-label="TypeScript"><code>{doctorSample}</code></pre>
      <p>
         <code>resolveAvailableDefaultTarget</code> returns the platform's screen reader when
         it is set up, and <code>virtual</code> with a <code>warning</code> when it is not.
      </p>
   </section>

   <section>
      <h2 id="page">One page for scan and reader</h2>
      <p>
         To scan and read the same page in the same state, such as after signing in, open
         the page once and pass it to both.
      </p>
      <pre data-label="TypeScript"><code>{pageSample}</code></pre>
      <dl class="defs defs--wide">
         <dt><code>withLoadedPage(load, callback, options?)</code></dt>
         <dd>Keeps a headless page open for the callback.</dd>
         <dt><code>withInteractiveBrowserPage(url, callback, options?)</code></dt>
         <dd>Opens a visible browser, so a person can sign in first.</dd>
      </dl>
      <p>
         Stopping the reader leaves your page open. One simulated reader can use a page at a
         time. A second one fails with <code>virtual-session-conflict</code>.
      </p>
   </section>

   <section>
      <h2 id="driver">Sessions</h2>
      <p>
         These are the functions <code>a1 sr</code> runs. In a test, use
         <code>screenReader</code> from <code>a11ied/test</code>, which manages the session
         for you.
      </p>
      <pre data-label="TypeScript"><code>{driverSample}</code></pre>
      <dl class="defs defs--wide">
         <dt><code>startDriverSession(options?)</code></dt>
         <dd>Starts a session. It does not load a page: call <code>attachDocumentToDriverSession</code> for the simulated screen reader, or open the page yourself for a real one.</dd>
         <dt><code>runDriverSessionAction(request)</code></dt>
         <dd>Runs one action. The request is typed per action, so a payload of the wrong shape does not compile.</dd>
         <dt><code>runDriverSessionBatch</code></dt>
         <dd>Runs several actions over one connection.</dd>
         <dt><code>getDriverSessionStatus()</code>, <code>getActiveDriverSession()</code></dt>
         <dd>Read the session without moving the cursor.</dd>
         <dt><code>runEphemeralDriverAction(options)</code></dt>
         <dd>One action in a session that stops before the call returns.</dd>
         <dt><code>stopDriverSession(options?)</code></dt>
         <dd>Stops the session and finishes any recording.</dd>
         <dt><code>buildDriverTranscript</code>, <code>formatTranscript</code>, <code>writeDriverTranscript</code></dt>
         <dd>Build, render, and save a transcript.</dd>
         <dt><code>listDriverCommands</code>, <code>resolveDriverCommand</code></dt>
         <dd>The named commands <code>a1 sr list</code> prints.</dd>
      </dl>
   </section>

   <section>
      <h2 id="audit">Audits</h2>
      <pre data-label="TypeScript"><code>{auditSample}</code></pre>
      <p>
         An audit is a folder with a SQLite database, so several processes can work on it at
         once. These are the functions behind <a href="/reference/cli#audit"><code>a1
         audit</code></a>.
      </p>
      <dl class="defs defs--wide">
         <dt><code>startAudit</code>, <code>openAudit</code>, <code>closeAudit</code>, <code>resolveAuditDir</code></dt>
         <dd>Create, open, close, and find an audit.</dd>
         <dt><code>addPage</code>, <code>excludePage</code>, <code>includePage</code>, <code>listPages</code></dt>
         <dd>Decide what is audited.</dd>
         <dt><code>discoverAuditPages</code>, <code>scanAuditPages</code></dt>
         <dd>Add a site's pages, and run the automated checks on them.</dd>
         <dt><code>claimNext</code>, <code>buildWorkPacket</code>, <code>renderWorkPacket</code></dt>
         <dd>Claim a unit for a worker, and get everything the worker needs.</dd>
         <dt><code>submitUnit</code></dt>
         <dd>Store a unit's results in one transaction. Throws <code>AuditError</code> with every problem in <code>problems</code>.</dd>
         <dt><code>reportProgress</code>, <code>blockUnit</code>, <code>reopenUnit</code>, <code>addLimitation</code></dt>
         <dd>Keep a claim alive, set a unit aside, queue it again, or record a limit of the audit.</dd>
         <dt><code>listFindings</code>, <code>dismissFinding</code>, <code>mergeFindings</code>, <code>updateFinding</code></dt>
         <dd>Read and correct findings.</dd>
         <dt><code>getAuditStatus</code>, <code>listCriterionRollups</code>, <code>listEvents</code></dt>
         <dd>Progress, each criterion's standing, and the activity log.</dd>
         <dt><code>buildAuditReport</code>, <code>writeAuditReport</code>, <code>startDashboardServer</code></dt>
         <dd>The report and the live progress page.</dd>
      </dl>
   </section>

   <section>
      <h2 id="errors">Errors</h2>
      <dl class="defs">
         <dt><code>CliUsageError</code></dt>
         <dd>Bad input. The CLI exits 2.</dd>
         <dt><code>CliEnvironmentError</code></dt>
         <dd>A missing browser or screen reader. The CLI exits 3.</dd>
         <dt><code>DriverCommandError</code></dt>
         <dd>A screen reader command that could not run.</dd>
         <dt><code>ScreenReaderAssertionError</code></dt>
         <dd>A failed check, from <code>a11ied/test</code>.</dd>
         <dt><code>AuditError</code></dt>
         <dd>A rejected audit operation.</dd>
      </dl>
      <p>All are exported classes, so <code>instanceof</code> works.</p>
   </section>

   <section>
      <h2 id="packages">Packages</h2>
      <p>
         Depend on <code>a11ied</code>. It re-exports what the scoped packages below provide.
         Install one of them only for something <code>a11ied</code> does not export.
      </p>
      <dl class="defs">
         <dt><code>@a11ied/core</code></dt>
         <dd>Scans, sessions, lookups, and machine checks.</dd>
         <dt><code>@a11ied/audit</code></dt>
         <dd>Audit storage, findings, and reports. No browser.</dd>
         <dt><code>@a11ied/guidepup</code></dt>
         <dd>The VoiceOver, NVDA, and simulated screen readers.</dd>
         <dt><code>@a11ied/wcag-data</code>, <code>@a11ied/wcag-engine</code></dt>
         <dd>The WCAG data and the lookups over it.</dd>
         <dt><code>@a11ied/contracts</code></dt>
         <dd>Schemas and types shared by the others.</dd>
         <dt><code>@a11ied/mcp-server</code></dt>
         <dd>The MCP server.</dd>
      </dl>
   </section>
</DocShell>
