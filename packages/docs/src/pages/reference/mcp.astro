import mcpConfig from '../../samples/mcp-config.json.txt?raw';

const toc = [
   { id: 'start', label: 'Start the server' },
   { id: 'tools', label: 'All tools' },
   { id: 'page', label: 'Page tools' },
   { id: 'lookup', label: 'Lookup tools' },
   { id: 'pattern', label: 'Pattern tools' },
   { id: 'sr', label: 'Screen reader tools' },
   { id: 'audit', label: 'Audit tools' },
