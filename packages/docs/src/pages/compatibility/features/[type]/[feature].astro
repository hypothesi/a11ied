---
import ExternalLink from '@lucide/astro/icons/external-link';
import InfoTip from '../../../../components/info-tip.astro';
import AriaAtReportResult from '../../../../components/support/aria-at-report-result.astro';
import AssertionSummaryBar from '../../../../components/support/assertion-summary-bar.astro';
import LocalTestResult from '../../../../components/support/local-test-result.astro';
import PlatformIcon from '../../../../components/support/platform-icon.astro';
import PlatformIconSprite from '../../../../components/support/platform-icon-sprite.astro';
import ResultRow from '../../../../components/support/result-row.astro';
import SegmentBar from '../../../../components/support/segment-bar.astro';
import SupportShare from '../../../../components/support/support-share.astro';
import {
   deriveOutcomeFromSummary,
   getAriaAtSummary,
   listFeatures,
   summarizeAssertions,
   type AriaAtFeatureDrilldownItem,
   type FeatureEnvironmentResult,
   type FeatureReport,
   type FeatureType,
   type LocalFeatureDrilldownItem,
} from '@a11ied/support-data';
import type { AssertionSummary, TestOutcome } from '@a11ied/support-data/types';
import DocShell from '../../../../layouts/doc-shell.astro';
import { docsLinks } from '../../../../lib/nav';
import {
   escapeHtml,
   formatCompactRatio,
   formatFeatureSummary,
   formatRowOsVersion,
   formatScreenReader,
   formatShortDate,
   groupByScreenReaderAndOs,
   isVirtualScreenReader,
   normalizeOsName,
   NOT_TESTED_LABEL,
   parseLicense,
} from '../../../../lib/support-grouping';
import { formatGroupCount, formatRowScreenReader } from '../../../../lib/support-rows';
import { getSupportShare } from '../../../../lib/support-share';
import '../../../../styles/support-rows.css';

const PERCENT_MULTIPLIER = 100;
const OS_ORDER: Readonly<Record<string, number>> = {
   macOS: 0,
   iOS: 1,
   Android: 2,
   Windows: 3,
};
const OS_OTHER_RANK = 4;

export function getStaticPaths(): readonly {
   readonly params: { readonly type: FeatureType; readonly feature: string };
   readonly props: { readonly feature: FeatureReport };
}[] {
   return listFeatures().map((feature) => ({
      params: {
         type: feature.type,
         feature: feature.refId,
      },
      props: {
         feature,
      },
   }));
}

export interface Props {
   feature: FeatureReport;
}

const { feature } = Astro.props;
const ariaAtSummary = getAriaAtSummary();
const license = parseLicense(ariaAtSummary.license);

type RowOutcome = 'pass' | 'partial' | 'fail' | 'untested';

function getSummaryOutcome(summary: AssertionSummary): RowOutcome {
   const derived = deriveOutcomeFromSummary(summary);

   return derived === 'fail' || derived === 'partial' ? derived : 'pass';
}

function getEnvOutcome(env: FeatureEnvironmentResult): RowOutcome {
   return env.status === 'untested' ? 'untested' : getSummaryOutcome(env.summary);
}

/**
 * What one environment recorded for one test case or one W3C report. It is the smallest
 * block of results, so both groupings show the same blocks in a different order.
 */
type ResultUnit =
   | { readonly kind: 'local'; readonly id: string; readonly item: LocalFeatureDrilldownItem }
   | {
        readonly kind: 'aria-at';
        readonly id: string;
        readonly planSlug: string;
        readonly tests: readonly AriaAtFeatureDrilldownItem[];
        readonly summary: AssertionSummary;
     };

function listUnits(env: FeatureEnvironmentResult, envIndex: number): readonly ResultUnit[] {
   const units: ResultUnit[] = [];
   const reports = new Map<string, AriaAtFeatureDrilldownItem[]>();

   for (const item of env.items) {
      if (item.kind === 'local') {
         units.push({ kind: 'local', id: `unit-${String(envIndex)}-${item.testSlug}`, item });
      } else {
         const key = `${item.planSlug}-${String(item.reportID)}`;

         reports.set(key, [ ...(reports.get(key) ?? []), item ]);
      }
   }

   for (const [ key, tests ] of reports) {
      const commandResults = tests.flatMap((test) => test.commandResults);

      units.push({
         kind: 'aria-at',
         id: `unit-${String(envIndex)}-${key}`,
         planSlug: tests[0]?.planSlug ?? '',
         tests,
         summary: summarizeAssertions(
            commandResults.flatMap((result) => result.assertions),
            commandResults.flatMap((result) => result.negativeSideEffects),
         ),
      });
   }

   return units;
}

/**
 * A row that holds one test already shows that test's counts, so totals for the row are
 * only worth printing when they add up more than one test.
 */
function hasOwnTotals(units: readonly ResultUnit[]): boolean {
   const [ first ] = units;

   return units.length > 1 || (first?.kind === 'aria-at' && first.tests.length > 1);
}

interface RowFact {
   readonly label: string;
   readonly value: string;
}

/** What the row's summary line does not already say about the environment. */
function listRowFacts(env: FeatureEnvironmentResult): readonly RowFact[] {
   const facts: RowFact[] = [];
   const isOsVersionShown = formatRowOsVersion(env.os, env.osVersion) !== normalizeOsName(env.os);

   if (isVirtualScreenReader(env.screenReader)) {
      facts.push({ label: 'Screen reader', value: formatScreenReader(env.screenReader, env.screenReaderVersion) });
   }
   if (!isOsVersionShown && env.osVersion.trim() !== '') {
      facts.push({ label: 'OS version', value: env.osVersion });
   }
   facts.push({ label: 'Device', value: env.device });
   // A test case that a11ied ran prints its own recording time with its log.
   if (env.source !== 'local') {
      facts.push({ label: 'Date', value: formatShortDate(env.testedAt) });
   }

   return facts;
}

const groupedEnvs = groupByScreenReaderAndOs(feature.versionedEnvironments, (env) => ({
   screenReader: env.screenReader,
   screenReaderVersion: env.screenReaderVersion,
   os: env.os,
   osVersion: env.osVersion,
   browser: env.browser,
   browserVersion: env.browserVersion,
   status: env.status,
}));

const screenReaderOptions = groupedEnvs.map((group) => group.screenReaderType);
const osSet = new Set<string>();
for (const group of groupedEnvs) {
   for (const osGroup of group.osGroups) {
      osSet.add(osGroup.os);
   }
}
const osOptions = [...osSet].toSorted((left, right) => {
   const leftRank = OS_ORDER[left] ?? OS_OTHER_RANK;
   const rightRank = OS_ORDER[right] ?? OS_OTHER_RANK;
   if (leftRank !== rightRank) {
      return leftRank - rightRank;
   }
   return left.localeCompare(right);
});

interface PlacedEnv {
   readonly env: FeatureEnvironmentResult;
   readonly screenReaderType: string;
   readonly osGroup: string;
   readonly units: readonly ResultUnit[];
}

const placedEnvs: readonly PlacedEnv[] = groupedEnvs.flatMap((group) =>
   group.osGroups.flatMap((osGroup) =>
      osGroup.items.map((env) => ({
         env,
         screenReaderType: group.screenReaderType,
         osGroup: osGroup.os,
         units: listUnits(env, feature.versionedEnvironments.indexOf(env)),
      })),
   ),
);
const unitsByEnv = new Map(placedEnvs.map((placed) => [ placed.env, placed.units ]));

interface TestRow {
   readonly placed: PlacedEnv;
   readonly unit: ResultUnit | undefined;
   readonly outcome: TestOutcome;
   readonly ratioText: string;
}

interface TestGroup {
   readonly title: string;
   readonly href: string | undefined;
   readonly kindLabel: string;
   readonly rows: TestRow[];
}

const NOT_TESTED_GROUP_KEY = 'untested';
const testGroups = new Map<string, TestGroup>();

for (const testCase of feature.localCases) {
   testGroups.set(`local|${testCase.slug}`, {
      title: testCase.title,
      href: `/compatibility/tests/${testCase.slug}/`,
      kindLabel: 'a11ied test case',
      rows: [],
   });
}
for (const plan of feature.ariaAtPlans) {
   testGroups.set(`aria-at|${plan.slug}`, {
      title: plan.title,
      href: `/compatibility/aria-at/${plan.slug}/`,
      kindLabel: `W3C ARIA-AT test plan · ${plan.versionString} · ${plan.phase}`,
      rows: [],
   });
}

const localGroupKeys = feature.localCases.map((testCase) => `local|${testCase.slug}`);

function toTestRow(placed: PlacedEnv, unit: ResultUnit): TestRow {
   if (unit.kind === 'local') {
      return {
         placed,
         unit,
         outcome: unit.item.outcome,
         ratioText: formatCompactRatio(unit.item.summary, true),
      };
   }

   return {
      placed,
      unit,
      outcome: getSummaryOutcome(unit.summary),
      ratioText: formatCompactRatio(unit.summary, true),
   };
}

for (const placed of placedEnvs) {
   for (const unit of placed.units) {
      const key = unit.kind === 'local' ? `local|${unit.item.testSlug}` : `aria-at|${unit.planSlug}`;

      testGroups.get(key)?.rows.push(toTestRow(placed, unit));
   }

   // An environment with no results yet is listed under every a11ied test case it would run.
   if (placed.units.length === 0) {
      const untestedRow: TestRow = { placed, unit: undefined, outcome: getEnvOutcome(placed.env), ratioText: '' };
      const keys = localGroupKeys.length > 0 ? localGroupKeys : [ NOT_TESTED_GROUP_KEY ];

      for (const key of keys) {
         const group = testGroups.get(key) ?? {
            title: NOT_TESTED_LABEL,
            href: undefined,
            kindLabel: 'Environments with no results yet',
            rows: [],
         };

         group.rows.push(untestedRow);
         testGroups.set(key, group);
      }
   }
}

const visibleTestGroups = [ ...testGroups.values() ].filter((group) => group.rows.length > 0);
const testRowCount = visibleTestGroups.reduce((memo, group) => memo + group.rows.length, 0);

const realTestedEnvs = feature.versionedEnvironments.filter(
   (env) => env.status === 'tested' && !isVirtualScreenReader(env.screenReader),
);

const passEnvsCount = realTestedEnvs.filter((env) => getEnvOutcome(env) === 'pass').length;
const partialEnvsCount = realTestedEnvs.filter((env) => getEnvOutcome(env) === 'partial').length;
const failEnvsCount = realTestedEnvs.filter((env) => getEnvOutcome(env) === 'fail').length;
const realTotal = realTestedEnvs.length;
const passPct = realTotal > 0 ? Math.round((passEnvsCount / realTotal) * PERCENT_MULTIPLIER) : 0;
const partialPct = realTotal > 0 ? Math.round((partialEnvsCount / realTotal) * PERCENT_MULTIPLIER) : 0;
const failPct = realTotal > 0 ? Math.max(0, PERCENT_MULTIPLIER - passPct - partialPct) : 0;

function formatOverviewHeadline(): string {
   if (failEnvsCount === realTotal) {
      return `0 of ${String(realTotal)} pass · each fails a MUST check`;
   }

   if (passEnvsCount === realTotal) {
      return `All ${String(realTotal)} pass`;
   }

   const parts = [ `${String(passEnvsCount)} of ${String(realTotal)} pass` ];

   if (partialEnvsCount > 0) {
      parts.push(`${String(partialEnvsCount)} partial`);
   }

   if (failEnvsCount > 0) {
      parts.push(`${String(failEnvsCount)} fail a MUST check`);
   }

   return parts.join(' · ');
}

const share = getSupportShare(feature);
const featureSummaryHtml = `<p>${escapeHtml(formatFeatureSummary(feature))}</p>`;

const toc = [ { id: 'env-support-heading', label: 'Test results' } ];
---

<DocShell
   title={feature.title}
   tabTitle={`${feature.title} (${feature.type.toUpperCase()}) screen reader support`}
   summary={featureSummaryHtml}
   links={docsLinks}
   variant="wide"
   toc={toc}
>
   <PlatformIconSprite />

   <nav class="srFeature-breadcrumb" aria-label="Breadcrumb" data-support-page>
      <a href="/compatibility">Screen reader compatibility</a>
      <span class="srFeature-separator" aria-hidden="true">/</span>
      <a href="/compatibility/#feature-directory">Features</a>
      <span class="srFeature-separator" aria-hidden="true">/</span>
      <span aria-current="page">
         {feature.type.toUpperCase()} / {feature.refId}
      </span>
   </nav>

   {feature.specURL && (
      <a href={feature.specURL} target="_blank" rel="noopener noreferrer" class="srFeature-specLink">
         <span>{feature.linkText}</span>
         <ExternalLink size={15} aria-hidden="true" focusable="false" />
      </a>
   )}

   <div class="srFeature-overview">
      <SupportShare share={share} size="large" />
      {realTotal > 0 && (
         <div class="srFeature-results">
            <p class="srFeature-resultsLabel">
               Every tested environment
               <InfoTip term="Every tested environment" glossaryTerm="Environment">
                  Each version of a screen reader and browser pair counts as its own result. The
                  simulated screen reader is left out.
               </InfoTip>
            </p>
            <p class="srFeature-headline">
               <strong>{formatOverviewHeadline()}</strong>
               {failEnvsCount > 0 && (
                  <InfoTip term="MUST check" glossaryTerm="MUST, SHOULD, MAY">
                     Something W3C ARIA-AT requires a screen reader to convey.
                  </InfoTip>
               )}
            </p>
            <SegmentBar
               segments={[
                  { tone: 'pass', percent: passPct },
                  { tone: 'partial', percent: partialPct },
                  { tone: 'fail', percent: failPct },
               ]}
            />
         </div>
      )}
   </div>

   <section class="srFeature-section" aria-labelledby="env-support-heading">
      <h2 id="env-support-heading">Test results</h2>

      <div class="srFeature-filters" role="region" aria-label="Group and filter results">
         <div class="srFeature-filterField srFeature-filterField--view" role="group" aria-labelledby="sr-feature-view-label">
            <span id="sr-feature-view-label" class="srFeature-filterLabel">Group by</span>
            <span class="srFeature-viewSwitch">
               <button type="button" class="srFeature-viewBtn" data-results-view-button="test" aria-pressed="true">
                  Test
               </button>
               <button type="button" class="srFeature-viewBtn" data-results-view-button="screen-reader" aria-pressed="false">
                  Screen reader
               </button>
            </span>
         </div>

         <div class="srFeature-filterField">
            <label for="sr-feature-sr">Screen Reader</label>
            <select id="sr-feature-sr">
               <option value="all">All screen readers</option>
               {screenReaderOptions.map((sr) => (
                  <option value={sr}>{sr}</option>
               ))}
            </select>
         </div>

         <div class="srFeature-filterField">
            <label for="sr-feature-os">Operating System</label>
            <select id="sr-feature-os">
               <option value="all">All OSes</option>
               {osOptions.map((os) => (
                  <option value={os}>{os}</option>
               ))}
            </select>
         </div>

         <div class="srFeature-filterField">
            <label for="sr-feature-browser-type">Browser Type</label>
            <select id="sr-feature-browser-type">
               <option value="all">All types</option>
               <option value="browser">Browsers only</option>
               <option value="webview">WebViews only</option>
            </select>
         </div>

         <div class="srFeature-filterActions">
            <button type="button" id="sr-feature-reset" class="srFeature-resetBtn">
               Reset filters
            </button>
            <p id="sr-feature-count" class="srFeature-count" role="status" aria-live="polite">
               Showing {testRowCount} of {testRowCount} {testRowCount === 1 ? 'result' : 'results'}
            </p>
         </div>
      </div>

      <div class="srGroups" data-results-view="test">
         {visibleTestGroups.map((group) => (
            <div class="srGroup" data-result-group>
               <div class="srGroup-head">
                  <div class="srGroup-titles">
                     <h3 class="srGroup-title">
                        {group.href ? <a href={group.href}>{group.title}</a> : group.title}
                     </h3>
                     <span class="srGroup-kind">{group.kindLabel}</span>
                  </div>
                  <span class="srGroup-count" data-result-group-count>
                     {formatGroupCount(group.rows.map((row) => row.outcome), 'result')}
                  </span>
               </div>

               <div class="srRowList">
                  {group.rows.map(({ placed, unit, outcome, ratioText }) => (
                     <ResultRow
                        outcome={outcome}
                        ratioText={ratioText}
                        screenReaderGroup={placed.screenReaderType}
                        screenReaderLabel={formatScreenReader(placed.screenReaderType, placed.env.screenReaderVersion)}
                        leadWithScreenReader
                        os={placed.env.os}
                        osGroup={placed.osGroup}
                        osVersion={placed.env.osVersion}
                        browser={placed.env.browser}
                        browserVersion={placed.env.browserVersion}
                        browserType={placed.env.browserType}
                     >
                        <div class="srRow-metaStrip">
                           {listRowFacts(placed.env).map((fact, index) => (
                              <>
                                 {index > 0 && <span aria-hidden="true">·</span>}
                                 <span><strong>{fact.label}:</strong> {fact.value}</span>
                              </>
                           ))}
                        </div>

                        {placed.env.status === 'untested' && placed.env.statusNote && (
                           <p class="srRow-statusNote">{placed.env.statusNote}</p>
                        )}

                        {unit && hasOwnTotals([ unit ]) && unit.kind === 'aria-at' && (
                           <AssertionSummaryBar summary={unit.summary} />
                        )}

                        {unit && (
                           <div data-unit-home={unit.id}>
                              <div data-unit={unit.id}>
                                 {unit.kind === 'local'
                                    ? <LocalTestResult item={unit.item} />
                                    : <AriaAtReportResult tests={unit.tests} />}
                              </div>
                           </div>
                        )}
                     </ResultRow>
                  ))}
               </div>
            </div>
         ))}
      </div>

      <div class="srGroups" data-results-view="screen-reader" hidden>
         {groupedEnvs.map((group) => (
            <div class="srGroup" data-result-group>
               <div class="srGroup-head">
                  <h3 class="srGroup-title">{group.screenReaderType}</h3>
                  <span class="srGroup-count" data-result-group-count>
                     {formatGroupCount(
                        group.osGroups.flatMap((osGroup) => osGroup.items.map(getEnvOutcome)),
                        'result',
                     )}
                  </span>
               </div>

               {group.osGroups.map((osGroup) => (
                  <div class="srOsGroup" data-os-group-block>
                     <h4 class="srOsGroup-title"><PlatformIcon os={osGroup.os} size={14} /> {osGroup.os}</h4>
                     <div class="srRowList">
                        {osGroup.items.map((env) => {
                           const units = unitsByEnv.get(env) ?? [];
                           const hasAssertions = env.summary.must.total + env.summary.should.total + env.summary.may.total > 0;

                           return (
                              <ResultRow
                                 outcome={getEnvOutcome(env)}
                                 ratioText={formatCompactRatio(env.summary, env.status === 'tested')}
                                 screenReaderGroup={group.screenReaderType}
                                 screenReaderLabel={formatRowScreenReader(group.screenReaderType, env.screenReaderVersion)}
                                 os={env.os}
                                 osGroup={osGroup.os}
                                 osVersion={env.osVersion}
                                 browser={env.browser}
                                 browserVersion={env.browserVersion}
                                 browserType={env.browserType}
                                 sourceLabel={env.source === 'local' ? 'a11ied' : 'ARIA-AT'}
                              >
                                 <div class="srRow-metaStrip">
                                    {listRowFacts(env).map((fact, index) => (
                                       <>
                                          {index > 0 && <span aria-hidden="true">·</span>}
                                          <span><strong>{fact.label}:</strong> {fact.value}</span>
                                       </>
                                    ))}
                                 </div>

                                 {env.status === 'untested' && env.statusNote && (
                                    <p class="srRow-statusNote">{env.statusNote}</p>
                                 )}

                                 {hasAssertions && hasOwnTotals(units) && <AssertionSummaryBar summary={env.summary} />}

                                 {units.length > 0 && (
                                    <div class="srRow-unitList">
                                       {units.map((unit) => <div class="srRow-unitSlot" data-unit-slot={unit.id}></div>)}
                                    </div>
                                 )}
                              </ResultRow>
                           );
                        })}
                     </div>
                  </div>
               ))}
            </div>
         ))}
      </div>

      <p id="sr-feature-empty" class="srFeature-empty" hidden>
         No results match the selected filters.
      </p>
   </section>

   <footer class="srFeature-attribution">
      <p>
         {feature.localEnvironmentCount} {feature.localEnvironmentCount === 1 ? 'environment' : 'environments'} tested
         by a11ied, {feature.ariaAtEnvironmentCount} by W3C ARIA-AT.
      </p>
      {feature.ariaAtEnvironmentCount > 0 && (
         <p>
            The W3C ARIA-AT results come from{' '}
            <a href={ariaAtSummary.upstreamURL} target="_blank" rel="noopener noreferrer">aria-at.w3.org</a>, under the{' '}
            <a href={license.url} target="_blank" rel="noopener noreferrer">{license.name}</a>.
         </p>
      )}
   </footer>
</DocShell>

<script>
   import '../../../../scripts/feature-detail-filters';
</script>

<style>
.srFeature-breadcrumb {
   display: flex;
   flex-wrap: wrap;
   align-items: center;
   gap: 0.45rem;
   font-size: 0.92rem;
}

.srFeature-separator,
.srFeature-breadcrumb span[aria-current="page"] {
   color: var(--ink-soft);
}

.srFeature-specLink {
   align-self: start;
   display: inline-flex;
   align-items: center;
   gap: 0.35rem;
   font-weight: 700;
}

.srFeature-overview {
   padding: 0.85rem 1rem;
   border: 1px solid color-mix(in oklch, var(--ink) 18%, transparent);
   border-radius: 4px;
   background: var(--paper-light);
   display: grid;
   grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
   gap: 1rem 2rem;
}

.srFeature-results {
   display: grid;
   grid-row: span 3;
   grid-template-rows: subgrid;
   row-gap: 0.4rem;
}

.srFeature-resultsLabel {
   margin: 0;
   font-family: var(--display);
   font-size: 0.74rem;
   font-weight: 700;
   letter-spacing: 0.05em;
   text-transform: uppercase;
   color: var(--ink-soft);
}

.srFeature-headline {
   align-self: end;
   margin: 0;
}


.srFeature-section {
   max-width: none;
   min-inline-size: 0;
   transform: none;
   gap: 1rem;
}

.srFeature-filters {
   display: flex;
   flex-wrap: wrap;
   align-items: end;
   gap: 0.65rem 0.75rem;
   padding: 0.85rem 1rem;
   border: 1px solid color-mix(in oklch, var(--ink) 18%, transparent);
   border-radius: 4px;
   background: var(--paper-light);
}

.srFeature-filterField {
   display: flex;
   flex: 1 1 8rem;
   flex-direction: column;
   gap: 0.25rem;
   min-inline-size: 0;
   max-inline-size: 15rem;
}

.srFeature-filterField--view {
   flex: 0 0 auto;
}

.srFeature-viewSwitch {
   display: inline-flex;
   border: 1px solid color-mix(in oklch, var(--ink) 28%, transparent);
   border-radius: 4px;
   overflow: hidden;
}

.srFeature-viewBtn {
   min-block-size: 34px;
   padding-block: 0.3rem;
   padding-inline: 0.7rem;
   border: 0;
   background: var(--paper);
   color: var(--ink);
   font: inherit;
   font-size: 0.88rem;
   cursor: pointer;
}

.srFeature-viewBtn + .srFeature-viewBtn {
   border-inline-start: 1px solid color-mix(in oklch, var(--ink) 28%, transparent);
}

.srFeature-viewBtn[aria-pressed='true'] {
   background: var(--ink);
   color: var(--yellow);
   font-weight: 700;
}

.srFeature-viewBtn:focus-visible {
   outline-offset: -3px;
}

.srFeature-filterLabel,
.srFeature-filterField label {
   font-family: var(--display);
   font-size: 0.74rem;
   font-weight: 700;
   text-transform: uppercase;
   letter-spacing: 0.05em;
   color: var(--ink-soft);
}

.srFeature-filterField select {
   inline-size: 100%;
   min-block-size: 36px;
   padding-inline: 0.55rem;
   border: 1px solid color-mix(in oklch, var(--ink) 28%, transparent);
   border-radius: 4px;
   background: var(--paper);
   color: var(--ink);
   font: inherit;
   font-size: 0.88rem;
}

.srFeature-filterActions {
   display: flex;
   flex: 1 1 auto;
   align-items: center;
   justify-content: space-between;
   gap: 0.65rem;
}

.srFeature-resetBtn {
   min-block-size: 34px;
   padding-block: 0.3rem;
   padding-inline: 0.75rem;
   border: 1px solid color-mix(in oklch, var(--ink) 28%, transparent);
   border-radius: 4px;
   background: var(--paper);
   color: var(--ink);
   font-family: var(--display);
   font-size: 0.8rem;
   font-weight: 700;
