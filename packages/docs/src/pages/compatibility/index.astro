         Single-feature HTML test cases run directly against real screen readers with <code>a11ied</code>.
      </p>

      <search aria-label="Filter test cases" class="srIndex-searchBox">
         <div class="srIndex-controls">
            <div class="srIndex-control srIndex-control--search">
               <label for="sr-search">Search scenarios</label>
               <div class="srIndex-inputWrap">
                  <Search class="srIndex-inputIcon" size={16} aria-hidden="true" focusable="false" />
                  <input
                     id="sr-search"
                     type="search"
                     placeholder="Search attribute, slug, behavior, tag..."
                     autocomplete="off"
                  />
               </div>
            </div>

            <div class="srIndex-control">
               <label for="sr-category">Category</label>
               <select id="sr-category">
                  <option value="all">All categories</option>
                  {categories.map((category) => (
                     <option value={category}>{formatCategoryLabel(category)}</option>
                  ))}
               </select>
            </div>

            <div class="srIndex-control">
               <label for="sr-attribute">Attribute</label>
               <select id="sr-attribute">
                  <option value="all">All attributes</option>
                  {attributes.map((attribute) => (
                     <option value={attribute}>{attribute}</option>
                  ))}
               </select>
            </div>

            <div class="srIndex-control">
               <label for="sr-browser-type">Browser Type</label>
               <select id="sr-browser-type">
                  <option value="all">All types</option>
                  <option value="browser">Userland Browsers</option>
                  <option value="webview">System WebViews</option>
               </select>
            </div>

            <div class="srIndex-control">
               <label for="sr-environment">Environment</label>
               <select id="sr-environment">
                  <option value="all">All environments</option>
                  {environmentFiles.map((envFile) => (
                     <option value={envFile.environment.id}>
                        {envFile.environment.label}
                     </option>
                  ))}
               </select>
            </div>

            <div class="srIndex-control">
               <label for="sr-outcome">Outcome</label>
               <select id="sr-outcome">
                  <option value="all">All outcomes</option>
                  <option value="pass">Pass</option>
                  <option value="partial">Partial</option>
                  <option value="fail">Fail</option>
                  <option value="not-applicable">N/A</option>
                  <option value="untested">Untested</option>
               </select>
            </div>

            <div class="srIndex-control srIndex-control--reset">
               <button id="sr-reset" type="button" class="ciuResetBtn">
                  <RotateCcw size={14} aria-hidden="true" focusable="false" />
                  <span>Reset</span>
               </button>
            </div>
         </div>

         <p id="sr-filter-status" class="srIndex-filterStatus" role="status" aria-live="polite">
            Showing {screenReaderTests.length} of {screenReaderTests.length} tests.
         </p>
      </search>

      <div
         class="srIndex-tableWrap"
         tabindex="0"
         role="region"
         aria-label="Test cases table"
         data-env-types={JSON.stringify(environmentTypes)}
      >
         <table class="srIndex-table">
            <caption class="srIndex-caption">
               Searchable and filterable table of screen reader test cases
            </caption>
            <thead>
               <tr>
                  <th scope="col">Scenario</th>
                  <th scope="col">Attribute</th>
                  {environmentFiles.map((envFile) => (
                     <th scope="col">{envFile.environment.shortLabel}</th>
                  ))}
                  <th scope="col">Standalone</th>
               </tr>
            </thead>
            <tbody>
               {preparedRows.map(({ testCase, outcomesByEnv, searchBlob }) => {
                  const featureMatch = listFeatureSummaryForTestAttribute(
                     testCase.attribute,
                  );
                  return (
                     <tr
                        data-sr-row="true"
                        data-search={searchBlob}
                        data-category={testCase.category}
                        data-attribute={testCase.attribute}
                        data-outcomes={JSON.stringify(outcomesByEnv)}
                     >
                        <th scope="row" class="srIndex-scenarioCell">
                           <a
                              href={`/compatibility/tests/${testCase.slug}/`}
                              class="srIndex-scenarioLink"
                           >
                              {testCase.title}
                           </a>
                           <p class="srIndex-scenarioSummary">{testCase.summary}</p>
                        </th>
                        <td class="srIndex-attrCell">
                           <span class="ciuInlineTag">
                              {formatCategoryLabel(testCase.category)}
                           </span>
                           {featureMatch ? (
                              <a href={`/compatibility/features/${featureMatch.type}/${featureMatch.refId}/`}>
                                 <code>{testCase.attribute}</code>
                              </a>
                           ) : (
                              <code>{testCase.attribute}</code>
                           )}
                        </td>
                        {environmentFiles.map((envFile) => {
                           const outcome = outcomesByEnv[envFile.environment.id] ?? 'untested';
                           return (
                              <td
                                 class="srIndex-outcomeCell"
                                 data-col-label={envFile.environment.shortLabel}
                              >
                                 <OutcomeBadge outcome={outcome} compact={true} />
                              </td>
                           );
                        })}
                        <td class="srIndex-caseCell" data-col-label="Standalone">
                           <a href={`/compatibility/cases/${testCase.slug}/`}>Bare HTML ↗</a>
                        </td>
                     </tr>
                  );
               })}
            </tbody>
         </table>
      </div>

      <p id="sr-empty-state" class="srIndex-emptyState" hidden>
         No screen reader test cases match the active filters.
      </p>
   </section>

   <section
      id="aria-at-plans"
