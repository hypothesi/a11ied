---
import { Code } from 'astro:components';
import RotateCcw from '@lucide/astro/icons/rotate-ccw';
import Search from '@lucide/astro/icons/search';
import {
   checkFeatureSupport,
   resolveBrowserslistTargets,
} from '@a11ied/compat';
import {
   formatCategoryLabel,
   getAriaAtSummary,
   getRunForTestAndEnvironment,
   getSummaryCounts,
   listAriaAtEnvironments,
   listAriaAtPlans,
   listAttributes,
   listCategories,
   listEnvironmentFiles,
   listFeatures,
   listFeatureSummaryForTestAttribute,
   screenReaderTests,
   type FeatureEnvironmentResult,
   type FeatureReport,
   type TestOutcome,
} from '@a11ied/support-data';
import OutcomeBadge from '../../components/support/outcome-badge.astro';
import DocShell from '../../layouts/doc-shell.astro';
import { docsLinks } from '../../lib/nav';
import {
   formatFeatureSummary,
   formatNameAndVersion,
   formatScreenReader,
   parseLicense,
} from '../../lib/support-grouping';

const MAX_CELLS_PER_COL = 4;
const MAX_TARGETS_PREVIEW = 8;
const MAJOR_MINOR_PARTS = 2;
const DATE_PREFIX_LEN = 10;
const PERCENT_MULTIPLIER = 100;

const BROWSERSLIST_PRESETS = [
   { id: 'defaults', label: 'defaults', query: 'defaults' },
   { id: 'last-2', label: 'last 2 versions', query: 'last 2 versions' },
   { id: 'wide', label: '> 0.5%, not dead', query: '> 0.5%, not dead' },
   { id: 'safari-17', label: 'safari >= 17', query: 'safari >= 17' },
   { id: 'android-chr', label: 'and_chr >= 109', query: 'and_chr >= 109' },
] as const;

const EXAMPLE_SEARCHES = [
   'aria-labelledby',
   'alert',
   'aria-expanded',
   'aria-live',
   '@checked',
   'dialog',
] as const;

const COLUMN_DEFS = [
   { id: 'macos-vo', label: 'macOS VoiceOver' },
   { id: 'android-tb', label: 'Android TalkBack' },
   { id: 'win-nvda', label: 'Windows NVDA' },
   { id: 'win-jaws', label: 'Windows JAWS' },
   { id: 'ios-vo', label: 'iOS VoiceOver' },
   { id: 'virtual', label: 'Simulated' },
] as const;

type ColumnId = (typeof COLUMN_DEFS)[number]['id'];

const environmentFiles = listEnvironmentFiles();
const attributes = listAttributes();
const categories = listCategories();
const summaryCounts = getSummaryCounts();
const features = listFeatures();
const ariaAtSummary = getAriaAtSummary();
const license = parseLicense(ariaAtSummary.license);
const ariaAtPlans = listAriaAtPlans();
const ariaAtEnvironments = listAriaAtEnvironments();

const presetSummaries: Record<string, string> = {};
for (const preset of BROWSERSLIST_PRESETS) {
   const resolved = resolveBrowserslistTargets({ browserslist: preset.query });
   const headTargets = resolved.rawTargets.slice(0, MAX_TARGETS_PREVIEW).join(', ');
   const extraCount = resolved.rawTargets.length - MAX_TARGETS_PREVIEW;
   const targetSuffix = extraCount > 0 ? `, +${String(extraCount)} more` : '';
   presetSummaries[preset.id] = `${preset.query} → ${headTargets}${targetSuffix}`;
}

const environmentTypes: Readonly<Record<string, 'browser' | 'webview'>> = Object.fromEntries(
   environmentFiles.map((envFile) => [
      envFile.environment.id,
      envFile.environment.browserType === 'webview' ? 'webview' : 'browser',
   ]),
);

function classifyColumn(env: FeatureEnvironmentResult): ColumnId {
   const osLower = env.os.toLowerCase();
   const srLower = env.screenReader.toLowerCase();
   if (srLower.includes('virtual') || srLower.includes('guidepup')) {
      return 'virtual';
   }
   if (osLower.includes('mac') && srLower.includes('voiceover')) {
      return 'macos-vo';
   }
   if (osLower.includes('ios') && srLower.includes('voiceover')) {
      return 'ios-vo';
   }
   if (osLower.includes('android') && srLower.includes('talkback')) {
      return 'android-tb';
   }
   if (srLower.includes('nvda')) {
      return 'win-nvda';
   }
   if (srLower.includes('jaws')) {
      return 'win-jaws';
   }
   return 'macos-vo';
}

function compareEnvRecency(
   left: FeatureEnvironmentResult,
   right: FeatureEnvironmentResult,
   presetKeys: ReadonlySet<string>,
): number {
   if (left.status !== right.status) {
      return left.status === 'tested' ? -1 : 1;
   }
   const leftMatched = presetKeys.has(left.environmentKey);
   const rightMatched = presetKeys.has(right.environmentKey);
   if (leftMatched !== rightMatched) {
      return leftMatched ? -1 : 1;
   }
   if (left.source !== right.source) {
      return left.source === 'local' ? -1 : 1;
   }
   return right.browserVersion.localeCompare(left.browserVersion, undefined, {
      numeric: true,
   });
}

function buildFeatureColumns(
   feature: FeatureReport,
   presetKeys: ReadonlySet<string>,
): readonly {
   readonly id: ColumnId;
   readonly label: string;
   readonly cells: readonly FeatureEnvironmentResult[];
   readonly extraCount: number;
}[] {
   const buckets = new Map<ColumnId, FeatureEnvironmentResult[]>();
   for (const col of COLUMN_DEFS) {
      buckets.set(col.id, []);
   }
   for (const env of feature.versionedEnvironments) {
      const colID = classifyColumn(env);
      const list = buckets.get(colID) ?? [];
      list.push(env);
      buckets.set(colID, list);
   }

   const columns: {
      readonly id: ColumnId;
      readonly label: string;
      readonly cells: readonly FeatureEnvironmentResult[];
      readonly extraCount: number;
   }[] = [];

   for (const col of COLUMN_DEFS) {
      const entries = (buckets.get(col.id) ?? []).toSorted((left, right) =>
         compareEnvRecency(left, right, presetKeys),
      );
      if (entries.length === 0) {
         continue;
      }
      const cells = entries.slice(0, MAX_CELLS_PER_COL);
      columns.push({
         id: col.id,
         label: col.label,
         cells,
         extraCount: Math.max(0, entries.length - cells.length),
      });
   }

   return columns;
}

type CellState = 'pass' | 'partial' | 'fail' | 'untested';

function resolveCellState(env: FeatureEnvironmentResult): {
   readonly state: CellState;
   readonly verdictGlyph: string;
   readonly ratioText: string;
} {
   if (env.status === 'untested') {
      return { state: 'untested', verdictGlyph: '—', ratioText: 'Untested' };
   }
   const { must, should, severeSideEffects, moderateSideEffects } = env.summary;
   if (must.failed > 0 || severeSideEffects > 0) {
      const ratio = must.total > 0 ? `${must.passed}/${must.total}` : 'Severe';
      return { state: 'fail', verdictGlyph: `✕ ${ratio}`, ratioText: `MUST ${ratio}` };
   }
   if (should.failed > 0 || moderateSideEffects > 0 || must.untestable > 0) {
      const ratio =
         must.total > 0
            ? `${must.passed}/${must.total}`
            : `${should.passed}/${should.total}`;
      return {
         state: 'partial',
         verdictGlyph: `◐ ${ratio}`,
         ratioText: must.total > 0 ? `Partial · MUST ${ratio}` : `SHOULD ${ratio}`,
      };
   }
   if (must.total > 0) {
      const ratio = `${must.passed}/${must.total}`;
      return { state: 'pass', verdictGlyph: `✓ ${ratio}`, ratioText: `MUST ${ratio}` };
   }
   const ratio = should.total > 0 ? `${should.passed}/${should.total}` : 'Pass';
   return {
      state: 'pass',
      verdictGlyph: `✓ ${ratio}`,
      ratioText: should.total > 0 ? `SHOULD ${ratio}` : 'Pass',
   };
}

function extractMajorVersion(rawVersion: string): string {
   if (!rawVersion || rawVersion.toLowerCase() === 'pending') {
      return '';
   }
   return rawVersion.split('.')[0] ?? rawVersion;
}

function extractMajorMinorVersion(rawVersion: string): string {
   if (!rawVersion || rawVersion.toLowerCase() === 'pending') {
      return '';
   }
   const clean = rawVersion.replace(/\s*\(.*\)$/u, '').trim();
   const parts = clean.split('.');
   return parts.length >= MAJOR_MINOR_PARTS
      ? `${parts[0]}.${parts[1]}`
      : (parts[0] ?? clean);
}

function formatShortBrowser(env: FeatureEnvironmentResult): string {
   const lower = env.browser.toLowerCase();
   const isPending = env.browserVersion.toLowerCase() === 'pending';
   let name = env.browser;
   if (lower.includes('headless')) {
      name = 'Headless Chrome';
   } else if (lower.includes('google chrome') || lower === 'chrome') {
      name = 'Chrome';
   } else if (lower.includes('android system webview')) {
      name = 'WebView';
   } else if (lower.includes('wkwebview')) {
      name = 'WKWebView';
   }

   if (isPending) {
      return `${name} · Pending`;
   }
   if (name === 'WKWebView') {
      return 'WKWebView';
   }
   if (name === 'Safari') {
      return `${name} ${extractMajorMinorVersion(env.browserVersion)}`;
   }
   return `${name} ${extractMajorVersion(env.browserVersion)}`;
}

function formatShortTileSub(env: FeatureEnvironmentResult, colID: ColumnId): string {
   const sourceTag = env.source === 'w3c-aria-at' ? ' · ARIA-AT' : '';
   switch (colID) {
      case 'macos-vo': {
         const osVer = extractMajorMinorVersion(env.osVersion);
         return `macOS ${osVer}${sourceTag}`;
      }
      case 'android-tb': {
         const srVer = extractMajorMinorVersion(env.screenReaderVersion);
         const osVer = extractMajorVersion(env.osVersion);
         return `TB ${srVer} · Android ${osVer}`;
      }
      case 'win-nvda': {
         return `NVDA ${env.screenReaderVersion}${sourceTag}`;
      }
      case 'win-jaws': {
         return `JAWS ${extractMajorVersion(env.screenReaderVersion)}${sourceTag}`;
      }
      case 'ios-vo': {
         return env.osVersion.toLowerCase() === 'pending'
            ? 'iOS · Pending'
            : `iOS ${env.osVersion}`;
      }
      case 'virtual': {
         return `Guidepup virtual ${env.screenReaderVersion}`;
      }
      default: {
         return `${env.os} ${env.osVersion}`;
      }
   }
}

function formatCompactOS(os: string, osVersion: string): string {
   if (!osVersion || osVersion.toLowerCase().startsWith('not recorded')) {
      return os;
   }
   return `${os} ${osVersion}`;
}

interface RealSrOverview {
   readonly accentState: CellState;
   readonly verdictText: string;
   readonly passPct: number;
   readonly partialPct: number;
   readonly failPct: number;
   readonly testedCount: number;
}

function computeRealSrOverview(feature: FeatureReport): RealSrOverview {
   const testedReal = feature.versionedEnvironments.filter((env) => {
      if (env.status !== 'tested') {
         return false;
      }
      const srLower = env.screenReader.toLowerCase();
      return !srLower.includes('virtual') && !srLower.includes('guidepup');
   });

   if (testedReal.length === 0) {
      return {
         accentState: 'untested',
         verdictText: 'Untested on real AT',
         passPct: 0,
         partialPct: 0,
         failPct: 0,
         testedCount: 0,
      };
   }

   let passCount = 0;
   let partialCount = 0;
   let failCount = 0;

   for (const env of testedReal) {
      const { state } = resolveCellState(env);
      if (state === 'pass') {
         passCount += 1;
      } else if (state === 'partial') {
         partialCount += 1;
      } else if (state === 'fail') {
         failCount += 1;
      }
   }

   const total = testedReal.length;
   const passPct = Math.round((passCount / total) * PERCENT_MULTIPLIER);
   const partialPct = Math.round((partialCount / total) * PERCENT_MULTIPLIER);
   const failPct = Math.max(0, PERCENT_MULTIPLIER - passPct - partialPct);

   let accentState: CellState = 'pass';
   let verdictText = `All ${String(total)} tested pass`;
   if (failCount === total) {
      accentState = 'fail';
      verdictText = `0/${String(total)} pass · Fails MUST`;
   } else if (failCount > 0 || partialCount > 0) {
      accentState = 'partial';
      const detailParts: string[] = [];
      if (failCount > 0) {
         detailParts.push(`${String(failCount)} fail`);
      }
      if (partialCount > 0) {
         detailParts.push(`${String(partialCount)} partial`);
      }
      verdictText = `${String(passCount)}/${String(total)} pass · ${detailParts.join(', ')}`;
   }

   return {
      accentState,
      verdictText,
      passPct,
      partialPct,
      failPct,
      testedCount: total,
   };
}

interface PresetVerdictPayload {
   readonly status: string;
   readonly matchedKeys: readonly string[];
   readonly untestedCount: number;
}

interface TileDetailPayload {
   readonly title: string;
   readonly meta: string;
   readonly verdict: string;
   readonly state: CellState;
   readonly href: string;
}

function buildTileDetail(
   feature: FeatureReport,
   env: FeatureEnvironmentResult,
   state: CellState,
): TileDetailPayload {
   const webviewLabel = env.browserType === 'webview' ? ' · WebView' : '';
   const sourceLabel = env.source === 'local' ? 'a11ied' : 'W3C ARIA-AT';
   const title = `${formatScreenReader(env.screenReader, env.screenReaderVersion)} on ${env.browser} ${env.browserVersion}${webviewLabel}`;
   const recorded = env.testedAt ? env.testedAt.slice(0, DATE_PREFIX_LEN) : 'Pending';
   const meta = `OS: ${formatCompactOS(env.os, env.osVersion)} · Device: ${env.device} · Source: ${sourceLabel} · Recorded: ${recorded}`;

   const { must, should, may, severeSideEffects, moderateSideEffects } = env.summary;
   const parts: string[] = [];
   if (env.status === 'untested') {
      parts.push(env.statusNote ?? 'Not yet tested in this environment.');
   } else {
      if (must.total > 0) {
         parts.push(`MUST ${String(must.passed)}/${String(must.total)}`);
      }
      if (should.total > 0) {
         parts.push(`SHOULD ${String(should.passed)}/${String(should.total)}`);
      }
      if (may.total > 0) {
         parts.push(`MAY ${String(may.passed)}/${String(may.total)}`);
      }
      parts.push(`${String(severeSideEffects + moderateSideEffects)} side effects`);
   }

   return {
      title,
      meta,
      verdict: parts.join(' · '),
      state,
      href: `/compatibility/features/${feature.type}/${feature.refId}/`,
   };
}

const RADIX_BASE36 = 36;
const envTokenMap = new Map<string, string>();

function getEnvToken(envKey: string): string {
   let token = envTokenMap.get(envKey);
   if (!token) {
      token = envTokenMap.size.toString(RADIX_BASE36);
      envTokenMap.set(envKey, token);
   }
   return token;
}

interface PreparedFeature {
   readonly feature: FeatureReport;
   readonly summaryLine: string;
   readonly overview: RealSrOverview;
   readonly columns: ReturnType<typeof buildFeatureColumns>;
   readonly presetVerdicts: Readonly<Record<string, PresetVerdictPayload>>;
   readonly searchBlob: string;
}

const preparedFeatures: PreparedFeature[] = features.map((feature) => {
   const presetVerdicts: Record<string, PresetVerdictPayload> = {};
   const matchedKeyUnion = new Set<string>();

   for (const preset of BROWSERSLIST_PRESETS) {
      const check = checkFeatureSupport(feature.key, { browserslist: preset.query });
      const matchedTokens: string[] = [];
      for (const match of check.matchedEnvironments) {
         const envKey = match.environment.environmentKey;
         matchedKeyUnion.add(envKey);
         matchedTokens.push(getEnvToken(envKey));
      }
      presetVerdicts[preset.id] = {
         status: check.status,
         matchedKeys: matchedTokens,
         untestedCount: check.untestedTargets.length,
      };
   }

   const searchBlob = [
      feature.title,
      feature.refId,
      feature.type,
      ...feature.localCases.map((testCase) => `${testCase.title} ${testCase.slug} ${testCase.summary}`),
      ...feature.ariaAtPlans.map((plan) => `${plan.title} ${plan.slug}`),
   ]
      .join(' ')
      .toLowerCase();

   return {
      feature,
      summaryLine: formatFeatureSummary(feature),
      overview: computeRealSrOverview(feature),
      columns: buildFeatureColumns(feature, matchedKeyUnion),
      presetVerdicts,
      searchBlob,
   };
});

interface PreparedRow {
   readonly testCase: (typeof screenReaderTests)[number];
   readonly outcomesByEnv: Readonly<Record<string, TestOutcome>>;
   readonly searchBlob: string;
}

const preparedRows: PreparedRow[] = screenReaderTests.map((testCase) => {
   const outcomesByEnv: Record<string, TestOutcome> = {};
   for (const envFile of environmentFiles) {
      const run = getRunForTestAndEnvironment(
         testCase.slug,
         envFile.environmentKey,
      );
      outcomesByEnv[envFile.environment.id] = run ? run.outcome : 'untested';
   }
   const searchBlob = [
      testCase.title,
      testCase.slug,
      testCase.attribute,
      testCase.featureGroup,
      testCase.summary,
      testCase.expectedBehavior,
      ...testCase.tags,
   ]
      .join(' ')
      .toLowerCase();
   return { testCase, outcomesByEnv, searchBlob };
});

const compatExampleCode = `import { checkCompatibility } from '@a11ied/compat';

const report = checkCompatibility({
   browserslist: 'defaults', // or load from .browserslistrc / package.json
   usages: [
      {
         type: 'aria',
         feature: 'aria-live',
         element: '<div aria-live="polite">',
         location: { file: 'src/toast.tsx', line: 12, column: 8 },
      },
      'aria:alert',
      '@checked',
   ],
});

for (const diagnostic of report.diagnostics) {
   console.log(diagnostic.severity, diagnostic.code, diagnostic.message);
}`;

const toc = [
   { id: 'ciu-search-panel', label: 'Can I use search' },
   { id: 'ciu-tablist', label: 'Compatibility tables' },
];
---

<DocShell
   title="Screen reader compatibility"
   summary="<p>What each screen reader says for ARIA and HTML features, by browser and operating system. Search for a feature, then pick a result to read the recorded speech.</p>"
   links={docsLinks}
   variant="wide"
   toc={toc}
>
   <div class="ciuViewSwitch">
      <div id="ciu-tablist" class="ciuTablist" role="tablist" aria-label="Compatibility views">
         <button
            type="button"
            role="tab"
            id="ciu-tab-features"
            class="ciuTab"
            aria-selected="true"
            tabindex="0"
            data-panel-target="feature-directory"
         >
            Features ({features.length})
         </button>
         <button
            type="button"
            role="tab"
            id="ciu-tab-cases"
            class="ciuTab"
            aria-selected="false"
            tabindex="-1"
            data-panel-target="test-cases"
         >
            Test cases ({screenReaderTests.length})
         </button>
         <button
            type="button"
            role="tab"
            id="ciu-tab-plans"
            class="ciuTab"
            aria-selected="false"
            tabindex="-1"
            data-panel-target="aria-at-plans"
         >
            W3C ARIA-AT plans ({ariaAtPlans.length})
         </button>
         <button
            type="button"
            role="tab"
            id="ciu-tab-api"
            class="ciuTab"
            aria-selected="false"
            tabindex="-1"
            data-panel-target="environments"
         >
            API &amp; environments ({summaryCounts.testedEnvironments + ariaAtEnvironments.length})
         </button>
      </div>
   </div>

   <section
      id="feature-directory"
      class="ciuTabPanel"
      role="tabpanel"
      aria-labelledby="ciu-tab-features"
      data-ciu-panel
   >
      <div id="ciu-search-panel" class="ciuHero">
         <search class="ciuHero-box" aria-label="Search feature compatibility">
            <div class="ciuSearch-sentence">
               <label for="ciu-search" class="ciuSearch-prompt">Can I use</label>
               <input
                  id="ciu-search"
                  type="search"
                  class="ciuSearch-input"
                  placeholder="aria-labelledby, role=alert, @checked, dialog..."
                  autocomplete="off"
               />
               <span class="ciuSearch-qmark" aria-hidden="true">?</span>
            </div>

            <div class="ciuSearch-examples" role="group" aria-label="Suggested searches">
               <span class="ciuSearch-examplesLabel">Examples:</span>
               {EXAMPLE_SEARCHES.map((term, index) => (
                  <>
                     {index > 0 && <span class="ciuSearch-sep" aria-hidden="true">·</span>}
                     <button type="button" class="ciuExampleLink" data-ciu-example={term}>
                        {term}
                     </button>
                  </>
               ))}
            </div>

            <div class="ciuFilters">
               <div class="ciuFilter">
                  <label for="ciu-browserslist">Browserslist target</label>
                  <select id="ciu-browserslist">
                     <option value="all">All tested environments</option>
                     {BROWSERSLIST_PRESETS.map((preset) => (
                        <option value={preset.id}>{preset.label}</option>
                     ))}
                  </select>
               </div>

               <div class="ciuFilter">
                  <label for="ciu-type">Feature type</label>
                  <select id="ciu-type">
                     <option value="all">All ({features.length})</option>
                     <option value="aria">ARIA</option>
                     <option value="html">HTML</option>
                  </select>
               </div>

               <div class="ciuFilter ciuFilter--action">
                  <button id="ciu-reset" type="button" class="ciuResetBtn">
                     <RotateCcw size={14} aria-hidden="true" focusable="false" />
                     <span>Reset</span>
                  </button>
               </div>
            </div>

            <div
               id="ciu-bl-banner"
               class="ciuBlBanner"
               data-preset-summaries={JSON.stringify(presetSummaries)}
               hidden
            >
               <strong>Targets:</strong>
               <span id="ciu-bl-banner-text"></span>
            </div>

            <div class="ciuHero-footer">
               <p id="ciu-status" class="ciuHero-status" role="status" aria-live="polite">
                  Showing {features.length} of {features.length} features.
               </p>
               <ul class="ciuLegend" aria-label="Compatibility legend">
                  <li class="ciuLegend-item"><span class="ciuSwatch ciuSwatch--pass" aria-hidden="true"></span>Supported</li>
                  <li class="ciuLegend-item"><span class="ciuSwatch ciuSwatch--partial" aria-hidden="true"></span>Partial</li>
                  <li class="ciuLegend-item"><span class="ciuSwatch ciuSwatch--fail" aria-hidden="true"></span>Fails MUST</li>
                  <li class="ciuLegend-item"><span class="ciuSwatch ciuSwatch--untested" aria-hidden="true"></span>Untested</li>
               </ul>
            </div>
            <p class="ciuHero-key">
               MUST and SHOULD are W3C ARIA-AT's terms. A MUST check is something a screen reader is
               required to convey. A SHOULD check is recommended.
            </p>
         </search>
      </div>

      <ul class="ciuCards">
         {preparedFeatures.map(({ feature, summaryLine, overview, columns, presetVerdicts, searchBlob }) => (
            <li
               class={`ciuCard ciuCard--${overview.accentState}`}
               data-ciu-card="true"
               data-type={feature.type}
               data-search={searchBlob}
               data-browserslist={JSON.stringify(presetVerdicts)}
               data-default-verdict={overview.verdictText}
            >
               <div class="ciuCard-top">
                  <div class="ciuCard-intro">
                     <h2 class="ciuCard-title">
                        <a href={`/compatibility/features/${feature.type}/${feature.refId}/`}>
                           {feature.title}
                        </a>
                     </h2>
                     <p class="ciuCard-desc">{summaryLine}</p>
                  </div>

                  <div class="ciuCard-support">
                     <div class="ciuCard-verdictRow">
                        <span
                           class={`ciuVerdictDot ciuVerdictDot--${overview.accentState}`}
                           data-ciu-verdict-dot
                           aria-hidden="true"
                        ></span>
                        <strong class="ciuCard-verdictText" data-ciu-verdict>
                           {overview.verdictText}
                        </strong>
                     </div>
                     {overview.testedCount > 0 && (
                        <div class="ciuSupportBar" aria-hidden="true">
                           {overview.passPct > 0 && (
                              <span
                                 class="ciuSupportBar-seg ciuSupportBar-seg--pass"
                                 style={`width: ${String(overview.passPct)}%`}
                              ></span>
                           )}
                           {overview.partialPct > 0 && (
                              <span
                                 class="ciuSupportBar-seg ciuSupportBar-seg--partial"
                                 style={`width: ${String(overview.partialPct)}%`}
                              ></span>
                           )}
                           {overview.failPct > 0 && (
                              <span
                                 class="ciuSupportBar-seg ciuSupportBar-seg--fail"
                                 style={`width: ${String(overview.failPct)}%`}
                              ></span>
                           )}
                        </div>
                     )}
                     <a
                        href={`/compatibility/features/${feature.type}/${feature.refId}/`}
                        class="ciuCard-reportLink"
                     >
                        Full report →
                     </a>
                  </div>
               </div>

               {columns.length > 0 && (
                  <div class="ciuColumns">
                     {columns.map((column) => (
                        <div class={`ciuCol${column.id === 'virtual' ? ' ciuCol--virtual' : ''}`}>
                           <h3 class="ciuCol-head">{column.label}</h3>
                           <div class="ciuCol-stack">
                              {column.cells.map((env) => {
                                 const verdict = resolveCellState(env);
                                 const detailPayload = buildTileDetail(feature, env, verdict.state);
                                 return (
                                    <button
                                       type="button"
                                       class={`ciuTile ciuTile--${verdict.state}`}
                                       aria-expanded="false"
                                       data-env-key={getEnvToken(env.environmentKey)}
                                       data-tile-detail={JSON.stringify(detailPayload)}
                                       title="Click to inspect exact OS, device, screen reader, and assertion details"
                                    >
                                       <span class="ciuTile-row">
                                          <span class="ciuTile-browser">{formatShortBrowser(env)}</span>
                                          <span class="ciuTile-ratio">{verdict.verdictGlyph}</span>
                                       </span>
                                       <span class="ciuTile-sub">{formatShortTileSub(env, column.id)}</span>
                                    </button>
                                 );
                              })}
                           </div>
                           {column.extraCount > 0 && (
                              <a
                                 href={`/compatibility/features/${feature.type}/${feature.refId}/`}
                                 class="ciuCol-more"
                              >
                                 +{column.extraCount} more
                              </a>
                           )}
                        </div>
                     ))}
                  </div>
               )}

               <div class="ciuDetailDrawer" data-ciu-detail hidden>
                  <div class="ciuDetailDrawer-head">
                     <strong data-ciu-detail-title></strong>
                     <button type="button" class="ciuDetailDrawer-close" data-ciu-detail-close>
                        Close
                     </button>
                  </div>
                  <p class="ciuDetailDrawer-meta" data-ciu-detail-meta></p>
                  <div class="ciuDetailDrawer-foot">
                     <span class="ciuDetailDrawer-verdict" data-ciu-detail-verdict></span>
                     <a href={`/compatibility/features/${feature.type}/${feature.refId}/`} data-ciu-detail-link>
                        Inspect assertions &amp; speech transcript →
                     </a>
                  </div>
               </div>

               <div class="ciuCard-foot">
                  <details class="ciuCard-more">
                     <summary>
                        {feature.localCases.length} test {feature.localCases.length === 1 ? 'case' : 'cases'} · {feature.ariaAtPlans.length} ARIA-AT {feature.ariaAtPlans.length === 1 ? 'plan' : 'plans'}
                     </summary>
                     <div class="ciuCard-moreBody">
                        {feature.localCases.length > 0 && (
                           <div class="ciuCard-linksGroup">
                              <h4>Test cases</h4>
                              <ul>
                                 {feature.localCases.map((testCase) => (
                                    <li>
                                       <a href={`/compatibility/tests/${testCase.slug}/`}>{testCase.title}</a>
                                       {' · '}
                                       <a href={`/compatibility/cases/${testCase.slug}/`} class="ciuBareLink">
                                          bare HTML
                                       </a>
                                    </li>
                                 ))}
                              </ul>
                           </div>
                        )}

                        {feature.ariaAtPlans.length > 0 && (
                           <div class="ciuCard-linksGroup">
                              <h4>W3C ARIA-AT plans</h4>
                              <ul>
                                 {feature.ariaAtPlans.map((plan) => (
                                    <li>
                                       <a href={`/compatibility/aria-at/${plan.slug}/`}>
                                          {plan.title} ({plan.versionString})
                                       </a>
                                    </li>
                                 ))}
                              </ul>
                           </div>
                        )}

                        {feature.specURL && (
                           <p class="ciuCard-specLink">
                              <a href={feature.specURL} target="_blank" rel="noopener noreferrer">
                                 {feature.linkText || 'Specification reference'} ↗
                              </a>
                           </p>
                        )}
                     </div>
                  </details>

                  {feature.specURL && (
                     <a
                        href={feature.specURL}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="ciuCard-footSpec"
                     >
                        W3C Spec ↗
                     </a>
                  )}
               </div>
            </li>
         ))}
      </ul>

      <p id="ciu-empty" class="srIndex-emptyState" hidden>
         No specification features match the active search or filters.
      </p>
   </section>

   <section
      id="test-cases"
      class="ciuTabPanel"
      role="tabpanel"
      aria-labelledby="ciu-tab-cases"
      data-ciu-panel
      hidden
   >
