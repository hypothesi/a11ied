                     {plan.versionString} · {plan.reports.length} {plan.reports.length === 1 ? 'report' : 'reports'}
                  </span>
               </div>
               <h3 class="srIndex-planTitle">
                  <a href={`/compatibility/aria-at/${plan.slug}/`}>{plan.title}</a>
               </h3>
               {plan.featureRefs.length > 0 && (
                  <p class="srIndex-planFeatures">
                     {plan.featureRefs.map((ref, index) => (
                        <>
                           {index > 0 && ' · '}
                           <a href={`/compatibility/features/${ref.type}/${ref.refId}/`}>
                              <code>{ref.refId}</code>
                           </a>
                        </>
                     ))}
                  </p>
