            <h2 class="ciuPanelHeading">Query this data from code</h2>
            <p>
               <code>@a11ied/compat</code> and <code>@a11ied/support-data</code> answer the
               same question in code. Use them in a lint rule or an editor extension to flag a
               feature that a screen reader in your <code>browserslist</code> targets does
               not support. See <a href="/guides/compat">check screen reader support in code</a>.
            </p>
            <div class="ciuCodeWrap" data-no-decorate="true">
               <Code code={compatExampleCode} lang="ts" theme="github-dark" />
            </div>
         </div>

         <div class="ciuFlatPanel">
            <h2 class="ciuPanelHeading">Where the results come from</h2>
            <p>
               a11ied ran the local tests with VoiceOver, TalkBack, and the simulated screen
               reader, and recorded what each one said. The rest are W3C ARIA-AT reports. See{' '}
               <a href="/guides/screen-reader">test with a screen reader</a> to run your own.
            </p>
            <dl class="ciuStatsList">
               <div>
                  <dt>Environments</dt>
                  <dd>{summaryCounts.testedEnvironments} tested / {summaryCounts.trackedEnvironments} tracked</dd>
               </div>
               <div>
                  <dt>Recorded runs</dt>
                  <dd>{summaryCounts.totalRuns}</dd>
               </div>
               <div>
                  <dt>W3C ARIA-AT reports</dt>
                  <dd>{ariaAtSummary.reportsCount} across {ariaAtEnvironments.length} environments</dd>
               </div>
            </dl>
         </div>
      </div>

      <h3 class="srIndex-subHeading">Environments a11ied tested</h3>
      <div class="srIndex-tableWrap" tabindex="0" role="region" aria-label="Environments a11ied tested">
         <table class="srIndex-table">
            <thead>
               <tr>
                  <th scope="col">Screen reader</th>
                  <th scope="col">Browser</th>
                  <th scope="col">Operating system</th>
                  <th scope="col">Device</th>
                  <th scope="col">Status</th>
               </tr>
            </thead>
            <tbody>
               {environmentFiles.map((envFile) => {
                  const env = envFile.environment;
                  return (
                     <tr>
                        <th scope="row">{formatScreenReader(env.screenReader, env.screenReaderVersion)}</th>
                        <td>
                           {formatNameAndVersion(env.browser, env.browserVersion)}
                           {env.browserType === 'webview' ? ' (WebView)' : ''}
                        </td>
                        <td>{formatNameAndVersion(env.os, env.osVersion)}</td>
                        <td>{env.device}</td>
                        <td>{envFile.status === 'tested' ? 'Tested' : (envFile.statusNote ?? 'Not yet tested')}</td>
                     </tr>
                  );
               })}
            </tbody>
         </table>
      </div>

      <h3 class="srIndex-subHeading srIndex-subHeading--spaced">
         Environments in W3C ARIA-AT reports
      </h3>
      <div
         class="srIndex-tableWrap"
         tabindex="0"
