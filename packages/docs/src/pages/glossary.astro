---
import DocShell from '../layouts/doc-shell.astro';
import { GLOSSARY_ENTRIES, getGlossaryEntryID, type GlossaryTerm } from '../lib/glossary';
import { docsLinks } from '../lib/nav';

const getLetter = (entry: { readonly term: GlossaryTerm }): string => entry.term.charAt(0).toUpperCase();
const letters = [ ...new Set(GLOSSARY_ENTRIES.map((entry) => getLetter(entry))) ];
const groups = letters.map((letter) => ({
   letter,
   entries: GLOSSARY_ENTRIES.filter((entry) => getLetter(entry) === letter),
}));
const toc = letters.map((letter) => ({
   id: `letter-${letter.toLowerCase()}`,
   label: letter,
}));
---

<DocShell
   title="Glossary"
   summary="<p>The terms these docs use, each in a sentence or two. Where a page explains a term in full, the entry links to it. Each term is a link to its own entry, so you can copy its address.</p>"
   links={docsLinks}
   toc={toc}
>
   {groups.map((group) => (
      <section>
         <h2 id={`letter-${group.letter.toLowerCase()}`}>{group.letter}</h2>
         <dl class="defs">
            {group.entries.map((entry) => (
               <>
                  <dt id={getGlossaryEntryID(entry.term)}>
                     <a class="heading-link" href={`#${getGlossaryEntryID(entry.term)}`}>{entry.term}</a>
                  </dt>
                  <dd set:html={entry.definition} />
               </>
            ))}
         </dl>
      </section>
   ))}
</DocShell>
