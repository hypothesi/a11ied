---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import reportSummary from '../assets/audit-report-summary.png';
import logo from '../assets/logo.png';
import Balloon from '../components/home/balloon.astro';
import SiteHead from '../components/site-head.astro';
import { REPOSITORY_URL } from '../lib/nav';
import { getPracticeURL, withPracticeURL } from '../lib/practice';
import checkSample from '../samples/check-broken-short.txt?raw';
import mcpConfig from '../samples/mcp-config.json.txt?raw';
import agentResult from '../samples/mcp-expect-result.json.txt?raw';
import expectFail from '../samples/sr-expect-fail.txt?raw';
import transcriptSample from '../samples/sr-transcript-dialog.txt?raw';
import failureSample from '../samples/vitest-failure.txt?raw';
import testSample from '../samples/vitest-home.ts.txt?raw';

const practiceURL = getPracticeURL(Astro);
const hasSearch = import.meta.env.PROD;
const basePath = import.meta.env.BASE_URL.replace(/\/*$/, '/');
const description =
   'a11ied is a CLI, testing library, and MCP server for automated screen reader and accessibility testing.';
const heroCommands = [
   `a1 sr start --sr virtual ${practiceURL}`,
   'a1 sr goto --role button --name "Invite member"',
   'a1 sr checkpoint opened',
   'a1 sr activate',
   'a1 sr expect dialog --since opened',
].join('\n');
const agentPrompt =
   `Check the Invite member dialog on ${practiceURL} with a11ied. Open it with the simulated screen reader and tell me whether the dialog is announced. Quote what the screen reader said.`;
const auditPrompt =
   'Audit https://example.com against WCAG 2.2 AA with a11ied. Do not submit the contact form. Use four workers.';
const skillsInstall = `npx -y @a1st/aix install ${REPOSITORY_URL}/blob/master/packages/skills/ai.json --only skills --user`;
const reportAlt =
   'The summary of an example audit report. The page does not meet WCAG 2.2 Level AA. 14 findings: 2 critical, 5 serious, 6 moderate, 1 minor. 10 criteria fail and 20 pass. A table lists what to fix first.';
---

<html lang="en">
   <head>
      <SiteHead title="a11ied: automated screen reader and accessibility testing" description={description} />
   </head>
   <body class="home">
      <a class="skip-link" href="#content">Skip to content</a>
      {hasSearch ? <pagefind-config bundle-path={`${basePath}pagefind/`} base-url={basePath}></pagefind-config> : null}

      <header class="topbar">
         <a class="brand" href="/" aria-label="a11ied home">
            <Image src={logo} alt="" class="mark" width={112} height={112} />
            <span class="brand-title">a<span class="brand-title-accent">11</span>ied</span>
         </a>
         <nav class="topnav" aria-label="Site">
            <a href="/overview">Docs</a>
            <a href="/quickstart">Quickstart</a>
            <a href="/reference/cli">CLI reference</a>
            <a href="/compatibility">Compatibility</a>
            <a class="icon-link" href={REPOSITORY_URL}><Icon name="mdi:github" aria-hidden="true" />GitHub</a>
         </nav>
         {hasSearch ? <pagefind-modal-trigger class="search-trigger" placeholder="Search the docs" hide-shortcut></pagefind-modal-trigger> : null}
      </header>

      <main id="content">
         <section class="hero band">
            <div class="wrap hero-grid">
               <div class="hero-copy">
                  <p class="kicker">For developers, auditors, and AI agents</p>
                  <h1>Automated screen reader and accessibility testing</h1>
                  <p class="lead">
                     <strong>a11ied</strong> is a CLI, testing library, and MCP server for automated
                     screen reader and accessibility testing.
                  </p>
                  <p class="lead">
                     Let AI coding agents verify their own fixes, catch WCAG violations in CI, and
                     assert what your UI announces to a screen reader in your Vitest suite.
                  </p>
                  <div class="actions">
                     <a class="button button--primary" href="/quickstart">Run the quickstart</a>
                     <a class="button" href="/overview">Read the docs</a>
                  </div>
                  <pre class="install"><code>npm install --global a11ied</code></pre>
               </div>
               <figure class="hero-show">
                  <pre><code>{heroCommands}</code></pre>
                  <pre data-label="OUTPUT"><code>{expectFail.trimEnd()}</code></pre>
                  <figcaption>
                     These five commands open a dialog on a <a href="/demo/team">demo page</a> and
                     check that a screen reader announces it. Nothing is announced, so the check
                     fails. A static scan cannot find this.
                  </figcaption>
               </figure>
            </div>
         </section>

         <section class="band band--ink" aria-labelledby="gap-heading">
            <div class="wrap">
               <h2 id="gap-heading">Static scans are not enough</h2>
               <p class="section-lead">
                  A static scan checks a page's markup against rules. a11ied runs that scan, and
                  it also presses keys, opens dialogs, and logs what a screen reader announces, so
                  you can test how a page behaves.
               </p>
               <ol class="tally">
                  <li><span class="tally-figure">86</span><span class="tally-label">success criteria in WCAG 2.2</span></li>
                  <li><span class="tally-figure">28</span><span class="tally-label">have an automated scanner rule, and each rule checks only part of its criterion</span></li>
                  <li><span class="tally-figure">58</span><span class="tally-label">have no scanner rule at all</span></li>
               </ol>
               <p class="section-lead">
                  With a11ied you test those with a keyboard and a screen reader: whether focus
                  moves into a dialog, whether an error message is announced, whether every
                  control can be reached.
               </p>
               <p><a class="button button--yellow" href="/test-methods">See how each criterion is tested</a></p>
            </div>
         </section>

         <section class="band" aria-labelledby="audit-heading">
            <div class="wrap">
               <div class="audit-grid">
                  <div class="audit-copy">
                     <p class="kicker">With Claude Code, Codex, Cursor, and other coding agents</p>
                     <h2 id="audit-heading">Automated accessibility audits</h2>
                     <p class="section-lead">
                        Ask your AI coding agent to audit a site against WCAG. It tests each page
                        with a scan, the keyboard, and a screen reader, and can split the work
                        among its own subagents. a11ied tracks every check and writes the report.
                     </p>
                     <p class="section-lead">
                        The report gives a verdict, each finding with a screenshot of the failing
                        element and how to fix it, what to fix first, and what could not be
                        verified.
                     </p>
                     <div class="actions">
                        <a class="button button--primary" href="/example-audit/">Browse an example report</a>
                        <a class="button" href="/guides/audit">How an audit works</a>
                     </div>
                  </div>
                  <figure class="audit-shot">
                     <a href="/example-audit/">
                        <Image src={reportSummary} alt={reportAlt} width={1400} />
                     </a>
                  </figure>
               </div>

               <ol class="cards steps">
                  <li class="card">
                     <h3><span class="step">Step 1</span> Install the agent skills</h3>
                     <p>
                        Two skills teach your agent how to test with a11ied and how to run an audit.
                        The agent then uses the <code>a1</code> command or the
                        <a href="/guides/agents">MCP server</a>, whichever it has.
                     </p>
                     <pre><code>{skillsInstall}</code></pre>
                     <p><a href="/guides/agent-skill">Install the agent skills</a></p>
                  </li>
                  <li class="card">
                     <h3><span class="step">Step 2</span> Ask your agent for an audit</h3>
                     <p>
                        Say what to audit and what the agent must not do, such as sending a form.
                        The agent runs the <code>a1 audit</code> commands. You do not have to.
                     </p>
                     <pre data-label="AI AGENT PROMPT"><code>{auditPrompt}</code></pre>
                     <p><a href="/guides/audit">Audit a site with AI agents</a></p>
                  </li>
                  <li class="card">
                     <h3><span class="step">Step 3</span> Read the report</h3>
                     <p>
                        The agent writes the report when the audit is done. Run this yourself at any
                        time for the report so far: one HTML file you can send to a client, plus
                        Markdown and JSON.
                     </p>
                     <pre><code>a1 audit report</code></pre>
                     <p><a href="/example-audit/">Browse an example report</a></p>
                  </li>
               </ol>
            </div>
         </section>

         <section class="band band--follow" aria-labelledby="features-heading">
            <div class="wrap">
               <h2 id="features-heading">Test while you build</h2>

               <article class="feature">
                  <div class="feature-copy">
                     <h3>Capture a log of all screen reader output</h3>
                     <p>
                        Drive VoiceOver on macOS, NVDA on Windows, or a simulated screen reader that
                        runs on any machine, all with the same commands. Move by heading, open a
                        dialog, send a form.
                     </p>
                     <p>
                        Everything the screen reader announces is logged in order, and you can save
                        the log to a file. In this example a dialog opens: its name is announced,
                        then focus moves to its first field.
                     </p>
                     <p><a href="/guides/screen-reader">Test with a screen reader</a></p>
                  </div>
                  <div class="feature-show">
                     <Balloon kind="speech">Supports VoiceOver and NVDA!</Balloon>
                     <pre><code>a1 sr transcript --since opened</code></pre>
                     <pre data-label="OUTPUT" data-reveal><code>{withPracticeURL(transcriptSample, practiceURL)}</code></pre>
                  </div>
               </article>

               <article class="feature feature--flip">
                  <div class="feature-copy">
                     <h3>Write end-to-end tests for screen reader behavior</h3>
                     <p>
                        Drive a screen reader from Vitest, Jest, Mocha, or Playwright Test. Move by
                        heading or landmark, press keys, and type into fields. Then assert on what
                        was announced, where the cursor is, and in what order.
                     </p>
                     <p>
                        When a test fails, the error shows what the screen reader said. The output
                        here is this test run against a page where the dialog opens and nothing is
                        announced.
                     </p>
                     <p><a href="/guides/vitest">Test with Vitest</a></p>
                  </div>
                  <div class="feature-show">
                     <Balloon kind="speech" mirror>Vitest! Jest! Mocha!</Balloon>
                     <pre data-label="invite.test.ts"><code>{withPracticeURL(testSample, practiceURL)}</code></pre>
                     <pre data-label="OUTPUT" data-reveal><code>{failureSample.trimEnd()}</code></pre>
                  </div>
               </article>

               <article class="feature">
                  <div class="feature-copy">
                     <h3>Give your AI coding agent accessibility tools</h3>
                     <p>
                        Add one block of configuration, and Claude Code, Cursor, or any other agent
                        that supports MCP gets 37 tools: scan a page, drive a screen reader, check a
                        widget against its ARIA pattern, look up a criterion. The agent can then
                        test the interface it writes.
                     </p>
                     <p>
                        In this example the agent asks whether a dialog is announced. a11ied answers
                        that it is not, so the agent can fix the dialog and check again.
                     </p>
                     <p><a href="/guides/agents">Connect an AI agent</a></p>
                  </div>
                  <div class="feature-show">
                     <Balloon kind="thought">Was the dialog announced?</Balloon>
                     <pre data-label="CONFIG"><code>{mcpConfig.trimEnd()}</code></pre>
                     <pre data-label="AI AGENT PROMPT"><code>{agentPrompt}</code></pre>
                     <pre data-label="OUTPUT" data-reveal><code>{agentResult.trimEnd()}</code></pre>
                  </div>
               </article>

               <article class="feature feature--flip">
                  <div class="feature-copy">
                     <h3>Scan a page for accessibility failures</h3>
                     <p>
                        One command lists every failing element with the WCAG criterion it breaks
                        and a command that looks up the fix.
                     </p>
                     <p>
                        It also gives you a checklist of the criteria on that page that need a
                        manual test, so you know what to check next.
                     </p>
                     <p><a href="/guides/violations">Fix scan failures</a></p>
                  </div>
                  <div class="feature-show">
                     <Balloon kind="signal" mirror>Scanning...</Balloon>
                     <pre><code>a1 check {practiceURL}</code></pre>
                     <pre data-label="OUTPUT" data-reveal><code>{withPracticeURL(checkSample, practiceURL)}</code></pre>
                  </div>
               </article>
            </div>
         </section>

         <section class="band band--follow" aria-labelledby="caniuse-heading">
            <div class="wrap">
               <div class="panel">
                  <div class="panel-art" aria-hidden="true">
                     <div class="burst">
                        <div class="burst-edge"><div class="burst-fill"><span class="burst-word">Pow!</span></div></div>
                     </div>
                  </div>
                  <div class="panel-copy">
                     <p class="caption">Screen reader compatibility</p>
                     <h2 id="caniuse-heading">It's caniuse for accessibility features</h2>
                     <p class="section-lead">
                        Look up an ARIA attribute, an ARIA role, or an HTML element and see what
                        VoiceOver, NVDA, JAWS, and TalkBack say for it, by browser and operating
                        system. It covers 60 features, and most results come from W3C ARIA-AT
                        reports.
                     </p>
                     <p><a class="button button--primary" href="/compatibility">Look up a feature</a></p>
                  </div>
               </div>
            </div>
         </section>

         <section class="band band--yellow" aria-labelledby="more-heading">
            <div class="wrap">
               <h2 id="more-heading">More commands</h2>
               <ul class="cards">
                  <li class="card">
                     <h3>Look up WCAG from the terminal</h3>
                     <p>All 86 criteria of WCAG 2.2 with the W3C's guidance, and a test procedure for the 55 at Levels A and AA. It ships in the package and works offline.</p>
                     <p><code>a1 wcag 4.1.3</code></p>
                  </li>
                  <li class="card">
                     <h3>Check widgets against W3C ARIA patterns</h3>
                     <p>For a widget such as a combobox or dialog, it presses every key the W3C's ARIA pattern documents and reports the keys that do nothing. It knows the 68 examples in the W3C's ARIA Authoring Practices Guide.</p>
                     <p><code>a1 pattern check</code></p>
                  </li>
                  <li class="card">
                     <h3>Fail a build on new accessibility problems</h3>
                     <p>A failed check exits with code 4, which stops a CI job. A baseline lets an existing site fail only on new problems. Reports come out as SARIF or EARL.</p>
                     <p><code>a1 axe --fail-on serious</code></p>
                  </li>
                  <li class="card">
                     <h3>Screenshot a page at any width, zoom, or Tab stop</h3>
                     <p>Take a screenshot at 320 pixels wide, at 200 percent zoom, with WCAG text spacing, or after four presses of Tab.</p>
                     <p><code>a1 capture</code></p>
                  </li>
                  <li class="card">
                     <h3>Print what TalkBack says on Android</h3>
                     <p>Turn TalkBack on over adb, on a phone or an emulator, and print what it says as focus moves through an app.</p>
                     <p><code>a1 talkback walk</code></p>
                  </li>
                  <li class="card">
                     <h3>Print a page's accessibility tree</h3>
                     <p>See the roles, names, and states a screen reader works from. Filter the tree by role or name, or click a control first to open a menu or dialog.</p>
                     <p><code>a1 tree</code></p>
                  </li>
               </ul>
            </div>
         </section>

         <section class="band band--ink band--cta" aria-labelledby="cta-heading">
            <div class="wrap narrow">
               <h2 id="cta-heading">Run your first check in five minutes</h2>
               <p class="section-lead">
                  Install it, scan a page, and capture what a screen reader announces on it. There
                  is no account to create, and the simulated screen reader needs no setup.
               </p>
               <pre class="install"><code>npm install --global a11ied</code></pre>
               <div class="actions">
                  <a class="button button--yellow" href="/quickstart">Run the quickstart</a>
                  <a class="button button--ghost" href={REPOSITORY_URL}>View the source</a>
               </div>
            </div>
         </section>
      </main>

      <footer class="site-foot">
         <div class="wrap foot-grid">
            <p>
               Built on <a href="https://github.com/dequelabs/axe-core">axe-core</a>,
               <a href="https://www.guidepup.dev/">Guidepup</a>,
               <a href="https://playwright.dev/">Playwright</a>, and the W3C's WCAG and ARIA data.
               The source is on <a href={REPOSITORY_URL}>GitHub</a>.
            </p>
            <nav aria-label="Footer">
               <a href="/overview">Docs</a>
               <a href="/quickstart">Quickstart</a>
               <a href="/guides/troubleshooting">Troubleshooting</a>
               <a href="/reference/cli">CLI reference</a>
               <a href="/glossary">Glossary</a>
               <a href="/llms.txt">llms.txt</a>
            </nav>
         </div>
      </footer>

      {hasSearch ? <pagefind-modal></pagefind-modal> : null}
      <script>
         import '../scripts/code-blocks';
      </script>
   </body>
</html>

<style>
   .home { --wrap: 72rem; }
   .wrap { width: min(100% - 2.5rem, var(--wrap)); margin-inline: auto; }
   .narrow { --wrap: 48rem; }
   .band { padding-block: clamp(3rem, 8vw, 6rem); }
   .hero { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
   .band > .wrap > * + * { margin-top: var(--lg); }
   /* Short samples wrap here, so the line that makes the point is never cut off. */
   pre, pre code { white-space: pre-wrap; overflow-wrap: anywhere; }

   /* Top bar */
   .topbar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sm) var(--xl); padding: var(--sm) clamp(1.25rem, 4vw, 3rem); background: var(--yellow); border-bottom: 3px solid var(--ink); }
   .topnav { display: flex; flex-wrap: wrap; gap: var(--xs) var(--lg); margin-inline-start: auto; }
   .topnav a { color: var(--ink); font-weight: 600; text-decoration: none; }
   .topnav a:hover { text-decoration: underline; text-decoration-thickness: 0.12em; }
   .topbar .search-trigger { min-width: 12rem; }

   /* Hero */
   /*
    * The halftone circle is two background layers: a sheet of dots, and paper over it with
    * a round hole. The copy has its own paper background, so contrast checkers measure the
    * text against a plain color.
    */
   .hero { --size: clamp(14rem, 36vw, 32rem); --hole: calc(100% - 9rem) 9rem; background: radial-gradient(circle at var(--hole), transparent calc(var(--size) / 2), var(--paper) calc(var(--size) / 2 + 1px)), radial-gradient(circle, var(--red) 2px, transparent 2.4px) 0 0 / 11px 11px, var(--paper); }
   .hero-copy { padding-block: var(--xs); background: var(--paper); }
   .hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
   .hero-show { min-width: 0; margin: 0; }
   .hero-show > pre + pre[data-label="OUTPUT"] { margin-top: 0; border-top: 0; }
   .hero-show figcaption { margin-top: var(--lg); padding: var(--sm) var(--md); background: var(--paper-light); border: 2px solid var(--ink); font-size: 1rem; line-height: 1.5; }
   .hero-copy > * + * { margin-top: var(--lg); }
   .kicker { margin: 0; color: var(--red-dark); font: 700 0.86rem/1.4 var(--display); letter-spacing: 0.14em; text-transform: uppercase; }
   h1 { margin: 0; font: 700 clamp(2.6rem, 5.4vw, 4.6rem)/0.92 var(--display); letter-spacing: -0.04em; text-transform: uppercase; text-wrap: balance; filter: drop-shadow(4px 4px 0 var(--yellow)) drop-shadow(3px 3px 0 color-mix(in oklch, var(--red) 62%, transparent)); }
   .lead { max-width: 40rem; color: var(--ink-soft); font-size: clamp(1.15rem, 1.8vw, 1.4rem); line-height: 1.5; }
   .lead + .lead { margin-top: var(--sm); }
   .actions { display: flex; flex-wrap: wrap; gap: var(--md); }
   .button { display: inline-block; padding: 0.75rem 1.25rem; background: var(--paper-light); color: var(--ink); border: 3px solid var(--ink); box-shadow: 5px 5px 0 var(--ink); font: 700 1.05rem/1 var(--display); letter-spacing: 0.06em; text-decoration: none; text-transform: uppercase; }
   .button:hover { transform: translate(2px, 2px); box-shadow: 3px 3px 0 var(--ink); }
   .button--primary { background: var(--ink); color: var(--yellow); box-shadow: 5px 5px 0 var(--red); }
   .button--primary:hover { box-shadow: 3px 3px 0 var(--red); }
   .button--yellow { background: var(--yellow); box-shadow: 5px 5px 0 var(--red); }
   .button--yellow:hover { box-shadow: 3px 3px 0 var(--red); }
   .button--ghost { background: transparent; color: var(--paper-light); border-color: var(--paper-light); box-shadow: none; }
   .button--ghost:hover { background: var(--paper-light); color: var(--ink); box-shadow: none; transform: none; }
   .install { max-width: 26rem; }

   /* Section headings */
   h2 { padding: 0; border: 0; font-size: clamp(2rem, 5vw, 3.6rem); line-height: 0.95; letter-spacing: -0.03em; }
   .section-lead { max-width: 44rem; color: var(--ink-soft); font-size: 1.2rem; line-height: 1.55; }
   h3 { font-size: 1.6rem; line-height: 1.05; text-transform: uppercase; letter-spacing: -0.01em; }

   .feature-show > pre + pre[data-label="OUTPUT"] { margin-top: 0; border-top: 0; }

   /* Dark and yellow bands */
   .band--ink { background: var(--ink); color: var(--paper-light); }
   .band--ink .kicker { color: var(--yellow); }
   .band--ink .section-lead { color: color-mix(in oklch, var(--paper-light) 88%, var(--ink)); }
   .band--ink h2 { color: var(--yellow); }
   .band--yellow { background: var(--yellow); border-block: 3px solid var(--ink); }

   .tally { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: var(--lg); margin: var(--xl) 0 0; padding: 0; list-style: none; }
   .tally li { display: grid; gap: var(--xs); margin: 0; padding-top: var(--md); border-top: 3px solid var(--yellow); }
   .tally-figure { color: var(--yellow); font: 700 clamp(4rem, 9vw, 6.5rem)/0.85 var(--display); letter-spacing: -0.04em; }
   .tally-label { font-size: 1.05rem; line-height: 1.5; }

   /* Features */
   .feature { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; }
   .band > .wrap > .feature { margin-top: var(--3xl); }
   .band > .wrap > h2 + .feature { margin-top: var(--2xl); }
   .feature--flip { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); }
   .feature--flip .feature-copy { order: 2; }
   .feature-copy > * + *, .feature-show > * + * { margin-top: var(--md); }
   .feature-copy p { color: var(--ink-soft); }
   /*
    * Each balloon sits on top of its terminal, and its tail overlaps the terminal's top
    * edge. That holds at every width, because the two are stacked in one column. The side
    * margins keep the tail clear of the Copy button in the terminal's corner.
    */
   .feature-show > :global(.balloon) { z-index: 3; margin-inline: auto 24%; margin-bottom: calc(-1 * var(--md) - 0.7rem); }
   .feature-show > :global(.balloon--mirror) { margin-inline: min(26%, 100% - 16rem) auto; }
   .feature-show { min-width: 0; }

   /* Audit */
   .audit-grid { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
   .audit-copy > * + * { margin-top: var(--lg); }
   /* The report screenshot is tilted away from the reader, and its far edge goes soft. */
   .audit-shot { min-width: 0; margin: 0; perspective: 1600px; }
   .audit-shot a { position: relative; display: block; overflow: hidden; aspect-ratio: 4 / 3; border: 3px solid var(--ink); box-shadow: 12px 12px 0 var(--red); transform: rotateY(-14deg) rotateX(6deg); transform-origin: 0 50%; }
   .audit-shot img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 0 0; }
   .audit-shot a::after { position: absolute; inset: 66% 0 0; backdrop-filter: blur(1.5px); mask-image: linear-gradient(to bottom, transparent, #000); content: ''; pointer-events: none; }
   .band > .wrap > .steps { margin-top: var(--3xl); }
   .steps .card { min-width: 0; }
   .steps .card > pre { margin-top: auto; }
   .steps .card > pre + p { margin-top: 0; }
   .step { display: block; margin-bottom: var(--xs); color: var(--red-dark); font-size: 0.86rem; letter-spacing: 0.14em; }
   /* Two paper bands in a row: the second drops its top padding so the gap is not doubled. */
   .band--follow { padding-top: 0; }

   /* Comic panel */
