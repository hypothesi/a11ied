---
interface Props {
   title: string;
   fixed: boolean;
}

const { title, fixed } = Astro.props;
const otherHref = fixed ? '/demo/team' : '/demo/team/fixed';
const otherLabel = fixed ? 'the version with the problems' : 'the fixed version';
---

<html lang="en">
   <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <meta name="robots" content="noindex" />
      <title>{title}</title>
      <style is:global>
         :root {
            color-scheme: light;
            --ink: #16202e;
            --ink-muted: #414b59;
            --ink-faint: #a2aab5;
            --line: #dfe3e9;
            --surface: #ffffff;
            --canvas: #f4f6f8;
            --brand: #144a9e;
            --brand-dark: #143b7d;
            --ok-bg: #dcf3e4;
            --ok-ink: #14512f;
            --warn-bg: #fdf0d5;
            --warn-ink: #6b4708;
         }

         * { box-sizing: border-box; }

         body {
            margin: 0;
            background: var(--canvas);
            color: var(--ink);
            font: 400 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
         }

         a { color: var(--brand-dark); }
         :focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }

         .topbar {
            display: flex;
            align-items: center;
            gap: 24px;
            padding: 0 24px;
            background: var(--surface);
            border-bottom: 1px solid var(--line);
         }
         .wordmark { font-size: 17px; font-weight: 700; letter-spacing: -0.01em; }
         .topbar nav { display: flex; gap: 4px; }
         .topbar nav a {
            padding: 16px 12px;
            border-bottom: 2px solid transparent;
            color: var(--ink-muted);
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
         }
         .topbar nav a[aria-current="page"] { border-bottom-color: var(--brand); color: var(--ink); }

         main { width: min(100%, 980px); margin: 0 auto; padding: 32px 24px 64px; }
         h1 { margin: 0 0 6px; font-size: 28px; letter-spacing: -0.02em; }
         .lede { max-width: 62ch; margin: 0 0 28px; color: var(--ink-muted); }

         .card { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; }

         .toolbar { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px; padding: 16px; border-bottom: 1px solid var(--line); }
         .toolbar-heading { flex: 1 1 100%; margin: 0; font-size: 16px; }
         .field { display: flex; flex-direction: column; gap: 4px; }
         .field label { font-size: 13px; font-weight: 600; color: var(--ink-muted); }
         input[type="search"], input[type="email"], select {
            padding: 8px 10px;
            border: 1px solid #b7bec9;
            border-radius: 6px;
            background: var(--surface);
            color: var(--ink);
            font: inherit;
            font-size: 14px;
         }
         input::placeholder { color: var(--ink-muted); }

         .chips { display: flex; gap: 6px; }
         .chip {
            padding: 7px 12px;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: var(--surface);
            color: var(--ink-muted);
            font: inherit;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
         }
         .chip--on { background: var(--ink); border-color: var(--ink); color: var(--surface); }

         .button {
            padding: 9px 14px;
            border: 1px solid transparent;
            border-radius: 6px;
            background: var(--brand);
            color: var(--surface);
            font: inherit;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
         }
         .button--quiet { background: var(--surface); border-color: #b7bec9; color: var(--ink); }
         .push-end { margin-inline-start: auto; }

         table { width: 100%; border-collapse: collapse; }
         caption { padding: 0 16px 12px; color: var(--ink-muted); font-size: 13px; text-align: start; }
         th, td { padding: 12px 16px; border-bottom: 1px solid var(--line); text-align: start; vertical-align: middle; }
         th { color: var(--ink-muted); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase; }
         tbody tr:last-child :is(th, td) { border-bottom: 0; }
         .member { display: flex; align-items: center; gap: 12px; }
         .member img { width: 34px; height: 34px; border-radius: 50%; }
         .member-name { font-weight: 600; }
         .member-email { color: var(--ink-muted); font-size: 13px; }
         .faint { color: var(--ink-faint); font-size: 13px; }
         .readable { color: var(--ink-muted); font-size: 13px; }

         .pill { display: inline-block; padding: 3px 9px; border-radius: 999px; font-size: 12px; font-weight: 700; }
         .pill--active { background: var(--ok-bg); color: var(--ok-ink); }
         .pill--pending { background: var(--canvas); color: var(--ink-faint); }
         .pill--pending-readable { background: var(--warn-bg); color: var(--warn-ink); }

         .icon-button {
            display: grid;
            place-items: center;
            width: 32px;
            height: 32px;
            padding: 0;
            border: 1px solid var(--line);
            border-radius: 6px;
            background: var(--surface);
            color: var(--ink-muted);
            cursor: pointer;
         }
         .icon-button svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }

         .banner { margin: 0 0 20px; padding: 12px 16px; border: 1px solid #7fae8b; border-radius: 8px; background: var(--ok-bg); color: var(--ok-ink); font-weight: 600; }
         .banner:empty { padding: 0; border: 0; }

         .backdrop { position: fixed; inset: 0; display: grid; place-items: center; padding: 24px; background: rgb(22 32 46 / 55%); }
         .backdrop[hidden] { display: none; }
         .modal { width: min(100%, 420px); padding: 24px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); color: var(--ink); }
         dialog.modal::backdrop { background: rgb(22 32 46 / 55%); }
         .modal h2 { margin: 0 0 16px; font-size: 19px; }
         .modal .field + .field { margin-top: 14px; }
         .modal input, .modal select { width: 100%; }
         .modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 22px; }

         .demo-footer { padding: 20px 24px 48px; border-top: 1px solid var(--line); background: var(--surface); }
         .demo-footer div { width: min(100%, 980px); margin: 0 auto; color: var(--ink-muted); font-size: 14px; }
         .demo-footer p { margin: 0 0 6px; }
      </style>
   </head>
   <body>
      <slot />
      <footer class="demo-footer">
         <div>
            <p>A practice page for <a href="/">a11ied</a>. Read the walkthrough in <a href="/guides/demo">practice on a broken page</a>, or open <a href={otherHref}>{otherLabel}</a>.</p>
            <p>The people, addresses, and dates on this page are invented.</p>
         </div>
      </footer>
   </body>
</html>
