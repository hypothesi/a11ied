{
   "name": "@a11ied/earl",
   "version": "0.1.0",
   "description": "Build W3C EARL 1.0 accessibility reports as JSON-LD.",
   "files": [
      "dist"
   ],
   "type": "module",
   "main": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      }
   },
   "publishConfig": {
      "access": "public"
   },
   "scripts": {
      "build": "tsup src/index.ts --format esm --dts --clean",
      "prepack": "npm run build",
      "typecheck": "tsc -p tsconfig.json --noEmit"
   },
   "dependencies": {
      "@a11ied/contracts": "0.1.0"
   }
}
