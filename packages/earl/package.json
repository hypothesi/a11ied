{
   "name": "@a11ied/earl",
   "version": "0.2.0",
   "description": "W3C EARL 1.0 reports as JSON-LD. Internal package of a11ied, published because the a1 CLI depends on it. Its API can change in any release; install a11ied instead.",
   "homepage": "https://github.com/hypothesi/a11ied/tree/master/packages/earl#readme",
   "bugs": {
      "url": "https://github.com/hypothesi/a11ied/issues"
   },
   "license": "MIT",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/hypothesi/a11ied.git",
      "directory": "packages/earl"
   },
   "files": [
      "dist",
      "CHANGELOG.md"
   ],
   "type": "module",
   "main": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      }
   },
   "publishConfig": {
      "access": "public"
   },
   "scripts": {
      "build": "tsup src/index.ts --format esm --dts --clean",
      "prepack": "npm run build",
      "typecheck": "tsc -p tsconfig.json --noEmit"
   },
   "dependencies": {
      "@a11ied/contracts": "0.2.0"
   },
   "engines": {
      "node": ">=24"
   }
}
