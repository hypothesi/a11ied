{
   "name": "@a11ied/support-data",
   "version": "0.3.0",
   "description": "Versioned screen reader and assistive technology compatibility dataset, test cases, and W3C ARIA-AT reports.",
   "keywords": [
      "a11y",
      "accessibility",
      "aria-at",
      "compatibility",
      "screen-reader"
   ],
   "homepage": "https://hypothesi.github.io/a11ied/compatibility/",
   "bugs": {
      "url": "https://github.com/hypothesi/a11ied/issues"
   },
   "license": "MIT",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/hypothesi/a11ied.git",
      "directory": "packages/support-data"
   },
   "files": [
      "dist",
      "data",
      "NOTICE.md",
      "CHANGELOG.md"
   ],
   "type": "module",
   "main": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      },
      "./types": {
         "types": "./dist/types.d.ts",
         "import": "./dist/types.js"
      },
      "./package.json": "./package.json"
   },
   "publishConfig": {
      "access": "public"
   },
   "scripts": {
      "build": "tsup src/index.ts src/types.ts --format esm --dts --clean",
      "prepack": "npm run build",
      "typecheck": "tsc -p tsconfig.json --noEmit"
   },
   "engines": {
      "node": ">=24"
   }
}
