{
   "name": "@a11ied/compat",
   "version": "0.1.1",
   "description": "Programmatic screen reader and assistive technology compatibility query and Browserslist diagnostics engine for editors, linters, and bundlers.",
   "keywords": [
      "a11y",
      "accessibility",
      "aria",
      "browserslist",
      "compatibility",
      "screen-reader"
   ],
   "homepage": "https://hypothesi.github.io/a11ied/guides/compatibility-api/",
   "bugs": {
      "url": "https://github.com/hypothesi/a11ied/issues"
   },
   "license": "MIT",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/hypothesi/a11ied.git",
      "directory": "packages/compat"
   },
   "files": [
      "dist",
      "NOTICE.md",
      "CHANGELOG.md"
   ],
   "type": "module",
   "main": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
   },
   "publishConfig": {
      "access": "public"
   },
   "scripts": {
      "build": "tsup src/index.ts --format esm --dts --clean",
      "prepack": "npm run build",
      "typecheck": "tsc -p tsconfig.json --noEmit"
   },
   "dependencies": {
      "@a11ied/support-data": "0.1.1",
      "browserslist": "4.29.6"
   },
   "engines": {
      "node": ">=24"
   }
}
