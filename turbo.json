{
   "$schema": "https://v2-9-6.turborepo.dev/schema.json",
   "tasks": {
      "build": {
         "dependsOn": ["^build"],
         "outputs": ["dist/**"]
      },
      "transit": {
         "dependsOn": ["^transit"]
      },
      "typecheck": {
         "dependsOn": ["transit"]
      },
      "dev": {
         "cache": false,
         "persistent": true
      },
      "//#lint": {},
      "//#clean": {
         "cache": false
      },
      "//#format": {
         "cache": false
      }
   }
}
